@model QuanLyKhachSan.Web.Models.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["NavbarOverlay"] = false;
}

<section class="auth-page">
    <div class="container auth-shell">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="auth-visual">
                    <div class="luxe-kicker text-white-50 mb-3">MEMBER EXPERIENCE</div>
                    <h2 class="mb-3">Kỳ nghỉ của bạn, được lưu giữ trong một tài khoản.</h2>
                    <p class="mb-0">Đăng nhập để theo dõi đơn đặt phòng, xem trạng thái xác nhận và quản lý thông tin lưu trú thuận tiện hơn.</p>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="auth-card p-4 p-md-5 d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <div class="luxe-kicker mb-2">WELCOME BACK</div>
                        <h1 class="luxe-title h2 fw-bold mb-2">Chào mừng trở lại</h1>
                        <p class="luxe-lead mb-0">Đăng nhập để tiếp tục hành trình cùng SAWADE.</p>
                    </div>

                    <form asp-controller="TaiKhoan" asp-action="DangNhap" method="post" data-sawade-busy="Đang đăng nhập...">
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-muted" asp-for="TaiKhoan">Số điện thoại hoặc Email</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-person text-muted"></i></span>
                                <input type="text" asp-for="TaiKhoan" class="form-control border-start-0" placeholder="Nhập số điện thoại hoặc email" autocomplete="username" required />
                            </div>
                            <span asp-validation-for="TaiKhoan" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted" asp-for="MatKhau">Mật khẩu</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-white border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                <input type="password" asp-for="MatKhau" class="form-control border-start-0" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                            </div>
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-sawade-primary w-100 rounded-pill py-3 fw-bold mb-3">
                            Đăng nhập <i class="bi bi-arrow-right ms-1"></i>
                        </button>

                        <div class="text-center small text-muted">
                            Chưa có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangKy" class="auth-link fw-bold text-decoration-none">Đăng ký ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
