@model QuanLyKhachSan.Web.Models.DangNhapViewModel
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["NavbarOverlay"] = false;
}

@section Styles {
    <style>
        .auth-benefit-list {
            list-style: none;
            padding: 0;
            margin: 18px 0 0;
            display: grid;
            gap: 8px;
        }

        .auth-benefit-list li {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.85rem;
            color: rgba(255, 255, 255, 0.88);
        }

        .auth-benefit-list i {
            color: var(--sawade-gold-300);
        }

        .auth-toggle-pwd {
            border-color: rgba(21, 49, 39, 0.14);
            border-left: 0;
            border-radius: 0 13px 13px 0 !important;
            background: #fff;
            color: var(--sawade-muted);
        }

        .auth-toggle-pwd:hover {
            background: var(--sawade-ivory-100);
            color: var(--sawade-forest-950);
        }

        .auth-pwd-input {
            border-right: 0 !important;
            border-radius: 0 !important;
        }
    </style>
}

<section class="auth-page">
    <div class="container auth-shell">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-6 d-none d-lg-block">
                <div class="auth-visual">
                    <div class="luxe-kicker mb-2" style="color: var(--sawade-gold-300);">MEMBER EXPERIENCE</div>
                    <h2 class="mb-3">Kỳ nghỉ của bạn, được lưu giữ trong một tài khoản.</h2>
                    <p class="mb-0">Đăng nhập để đặt phòng nhanh hơn, theo dõi trạng thái xác nhận và tra cứu toàn bộ lịch sử lưu trú tại SAWADE.</p>
                    <ul class="auth-benefit-list">
                        <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Tự động điền thông tin khách hàng khi đặt phòng</li>
                        <li><i class="bi bi-check-circle-fill" aria-hidden="true"></i>Theo dõi trạng thái duyệt đơn &amp; in phiếu đặt phòng</li>
                    </ul>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="auth-card d-flex flex-column justify-content-center">
                    <div class="mb-4">
                        <div class="luxe-kicker mb-2">WELCOME BACK</div>
                        <h1 class="luxe-title mb-2">Chào mừng trở lại</h1>
                        <p class="luxe-lead small mb-0">Đăng nhập để tiếp tục hành trình nghỉ dưỡng cùng SAWADE.</p>
                    </div>

                    <form asp-controller="TaiKhoan" asp-action="DangNhap" method="post" data-sawade-busy="Đang đăng nhập...">
                        <div class="mb-3">
                            <label class="form-label" asp-for="TaiKhoan">Số điện thoại hoặc Email</label>
                            <div class="input-group">
                                <span class="input-group-text border-end-0"><i class="bi bi-person" aria-hidden="true"></i></span>
                                <input type="text" asp-for="TaiKhoan" class="form-control border-start-0" placeholder="Nhập số điện thoại hoặc email" autocomplete="username" required />
                            </div>
                            <span asp-validation-for="TaiKhoan" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label" asp-for="MatKhau">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text border-end-0"><i class="bi bi-lock" aria-hidden="true"></i></span>
                                <input type="password" asp-for="MatKhau" id="loginPassword" class="form-control border-start-0 auth-pwd-input" placeholder="Nhập mật khẩu" autocomplete="current-password" required />
                                <button type="button" class="btn auth-toggle-pwd" data-toggle-pwd="loginPassword" aria-label="Hiện hoặc ẩn mật khẩu">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </button>
                            </div>
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-sawade-primary w-100 rounded-pill py-3 mb-3">
                            Đăng nhập <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                        </button>

                        <div class="text-center small text-muted pt-1">
                            Chưa có tài khoản?
                            <a asp-controller="TaiKhoan" asp-action="DangKy" class="auth-link text-decoration-none ms-1">Đăng ký ngay</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (() => {
            document.querySelectorAll('[data-toggle-pwd]').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const input = document.getElementById(btn.getAttribute('data-toggle-pwd'));
                    if (!input) return;
                    const isHidden = input.type === 'password';
                    input.type = isHidden ? 'text' : 'password';
                    btn.innerHTML = isHidden
                        ? '<i class="bi bi-eye-slash" aria-hidden="true"></i>'
                        : '<i class="bi bi-eye" aria-hidden="true"></i>';
                });
            });
        })();
    </script>
}
