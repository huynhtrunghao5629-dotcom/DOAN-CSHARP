@model QuanLyKhachSan.Web.Models.DangKyViewModel
@{
    ViewData["Title"] = "Đăng ký thành viên";
    ViewData["NavbarOverlay"] = false;
}

<section class="auth-page">
    <div class="container auth-shell">
        <div class="row g-4 align-items-stretch">
            <div class="col-lg-5 d-none d-lg-block">
                <div class="auth-visual">
                    <div class="luxe-kicker text-white-50 mb-3">SAWADE MEMBERSHIP</div>
                    <h2 class="mb-3">Bắt đầu một hành trình nghỉ dưỡng thuận tiện hơn.</h2>
                    <p class="mb-0">Tạo tài khoản để đặt phòng, theo dõi lịch sử và quản lý thông tin cá nhân trên cùng một nơi.</p>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="auth-card p-4 p-md-5">
                    <div class="mb-4">
                        <div class="luxe-kicker mb-2">CREATE ACCOUNT</div>
                        <h1 class="luxe-title h2 fw-bold mb-2">Đăng ký thành viên SAWADE</h1>
                        <p class="luxe-lead mb-0">Điền thông tin bên dưới để tạo tài khoản đặt phòng.</p>
                    </div>

                    <form asp-controller="TaiKhoan" asp-action="DangKy" method="post" class="row g-3" data-sawade-busy="Đang tạo tài khoản...">
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted" asp-for="HoTen">Họ và tên *</label>
                            <input type="text" asp-for="HoTen" class="form-control form-control-lg rounded-3" placeholder="Nhập họ tên đầy đủ" autocomplete="name" required />
                            <span asp-validation-for="HoTen" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted" asp-for="SoDienThoai">Số điện thoại *</label>
                            <input type="tel" asp-for="SoDienThoai" class="form-control form-control-lg rounded-3" placeholder="Nhập số điện thoại" autocomplete="tel" required />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted" asp-for="CCCD">CCCD / CMND *</label>
                            <input type="text" asp-for="CCCD" class="form-control form-control-lg rounded-3" placeholder="Số giấy tờ" required />
                            <span asp-validation-for="CCCD" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted" asp-for="Email">Email</label>
                            <input type="email" asp-for="Email" class="form-control form-control-lg rounded-3" placeholder="example@gmail.com" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted" asp-for="MatKhau">Mật khẩu *</label>
                            <input type="password" asp-for="MatKhau" class="form-control form-control-lg rounded-3" placeholder="Tạo mật khẩu" autocomplete="new-password" required />
                            <span asp-validation-for="MatKhau" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted" asp-for="XacNhanMatKhau">Xác nhận mật khẩu *</label>
                            <input type="password" asp-for="XacNhanMatKhau" class="form-control form-control-lg rounded-3" placeholder="Nhập lại mật khẩu" autocomplete="new-password" required />
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                        </div>

                        <div class="col-12 mt-4">
                            <button type="submit" class="btn btn-sawade-primary w-100 rounded-pill py-3 fw-bold mb-3">
                                Hoàn tất đăng ký <i class="bi bi-arrow-right ms-1"></i>
                            </button>
                            <div class="text-center small text-muted">
                                Đã có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangNhap" class="auth-link fw-bold text-decoration-none">Đăng nhập ngay</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
