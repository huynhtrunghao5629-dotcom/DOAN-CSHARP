@model IEnumerable<QuanLyKhachSan.Web.Models.DichVuKhachViewModel>
@{
    ViewData["Title"] = "Dịch vụ khách sạn";
    ViewData["NavbarOverlay"] = false;
    var services = Model?.ToList() ?? new();
}

@section Styles {
    <style>
        .services-toolbar {
            padding: 22px 26px;
            border: 1px solid var(--sawade-line-strong);
            background: var(--sawade-ivory-50);
        }

        .services-count-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border: 1px solid var(--sawade-line-strong);
            background: var(--sawade-ivory-100);
            color: var(--sawade-forest-900);
            font-size: 0.74rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .service-idx {
            font-family: var(--sawade-font-display);
            font-size: 1.5rem;
            color: var(--sawade-gold-500);
            line-height: 1;
        }

        .service-price-val {
            font-family: var(--sawade-font-display);
            color: var(--sawade-forest-950);
            font-size: 1.55rem;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
            line-height: 1.1;
        }

        .service-unit-text {
            font-size: 0.76rem;
            color: var(--sawade-muted);
        }

        .services-note-box {
            padding: 20px 24px;
            border: 1px solid var(--sawade-line-strong);
            border-left: 3px solid var(--sawade-gold-500);
            background: var(--sawade-ivory-50);
            color: var(--sawade-ink-soft);
            font-size: 0.87rem;
        }
    </style>
}

<section class="luxe-page">
    <div class="container">
        <header class="luxe-page-head">
            <div class="luxe-kicker mb-2">SAWADE CONCIERGE &amp; SERVICES</div>
            <h1 class="luxe-title mb-3">Những tiện ích làm kỳ nghỉ trọn vẹn hơn</h1>
            <div class="editorial-rule my-3"></div>
            <p class="luxe-lead mb-0">Danh mục dịch vụ đi kèm và biểu giá tham khảo được đồng bộ trực tiếp từ hệ thống quản trị khách sạn.</p>
        </header>

        @if (ViewBag.ApiError != null)
        {
            <div class="alert alert-warning mb-4" role="alert">
                <i class="bi bi-wifi-off me-2" aria-hidden="true"></i>@ViewBag.ApiError
                <a asp-controller="Home" asp-action="DichVu" class="alert-link ms-2">Thử tải lại</a>
            </div>
        }

        @if (services.Any())
        {
            <div class="services-toolbar mb-5">
                <div class="row justify-content-between align-items-end g-3">
                    <div class="col-md-7 col-lg-5">
                        <label class="form-label" for="serviceSearch">Tìm kiếm dịch vụ</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0"><i class="bi bi-search" aria-hidden="true"></i></span>
                            <input id="serviceSearch" type="search" class="form-control border-start-0" placeholder="Ví dụ: ăn sáng, giặt ủi, đưa đón..." />
                        </div>
                    </div>
                    <div class="col-md-auto">
                        <span class="services-count-tag">
                            <span id="serviceCount" class="tabular-nums">@services.Count</span> dịch vụ
                        </span>
                    </div>
                </div>
            </div>

            <div class="row g-4" id="servicesGrid">
                @{ var sIndex = 0; }
                @foreach (var service in services)
                {
                    sIndex++;
                    <div class="col-md-6 col-xl-4 service-item" data-search="@(HienThiDichVu.Ten(service.TenDichVu) + " " + HienThiDichVu.MoTa(service.MoTa))">
                        <article class="service-luxe-card h-100 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                                <span class="service-idx">@sIndex.ToString("D2")</span>
                                <div class="service-luxe-icon">
                                    <i class="bi @HienThiDichVu.Icon(service.TenDichVu)" aria-hidden="true"></i>
                                </div>
                            </div>

                            <h2 class="editorial-serif h3 mb-2">@HienThiDichVu.Ten(service.TenDichVu)</h2>

                            @if (!string.IsNullOrWhiteSpace(service.MoTa))
                            {
                                <p class="text-muted small mb-4">@HienThiDichVu.MoTa(service.MoTa)</p>
                            }
                            else
                            {
                                <p class="text-muted small mb-4">Dịch vụ đi kèm phục vụ trực tiếp tại phòng hoặc khu vực tiện ích khách sạn.</p>
                            }

                            <div class="border-top mt-auto pt-3 d-flex justify-content-between align-items-end gap-3">
                                <span class="text-muted" style="font-size: 0.68rem; letter-spacing: 0.14em; text-transform: uppercase;">Biểu giá</span>
                                <div class="text-end">
                                    <div class="service-price-val">@service.DonGia.ToString("N0") đ</div>
                                    <div class="service-unit-text">/ @HienThiDichVu.DonVi(service.DonViTinh)</div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <div id="noServices" class="bg-white border p-5 text-center mt-4" hidden>
                <div class="sawade-empty-icon mb-3"><i class="bi bi-search" aria-hidden="true"></i></div>
                <h2 class="editorial-serif h4 mb-1">Không tìm thấy dịch vụ phù hợp</h2>
                <p class="text-muted small mb-0">Hãy thử từ khóa ngắn hơn hoặc xóa ô tìm kiếm để xem toàn bộ danh mục.</p>
            </div>

            <div class="services-note-box mt-5 d-flex align-items-start gap-3">
                <i class="bi bi-info-circle text-gold fs-5 mt-1" aria-hidden="true"></i>
                <div>
                    Dịch vụ phát sinh được lễ tân ghi nhận trực tiếp vào mã đơn đặt phòng và tổng hợp vào hóa đơn khi trả phòng. Trang này dùng để tra cứu danh mục và mức giá tham khảo, chưa hỗ trợ đặt dịch vụ riêng trực tuyến.
                </div>
            </div>
        }
        else if (ViewBag.ApiError == null)
        {
            <div class="service-luxe-card text-center p-5 mx-auto" style="max-width: 640px;">
                <div class="sawade-empty-icon mb-3"><i class="bi bi-bag-x" aria-hidden="true"></i></div>
                <h2 class="editorial-serif h4 mt-2">Chưa có dịch vụ để hiển thị</h2>
                <p class="text-muted mb-0">Danh mục dịch vụ đang được cập nhật trên hệ thống.</p>
            </div>
        }

        <div class="text-center mt-5 pt-2">
            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-primary btn-lg">
                Khám phá phòng nghỉ <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

@section Scripts {
<script>
 (() => {
   const search = document.getElementById('serviceSearch');
   if (!search) return;
   const cards = [...document.querySelectorAll('.service-item')];
   const count = document.getElementById('serviceCount');
   const empty = document.getElementById('noServices');
   const boDau = text => (text || '')
     .normalize('NFD')
     .replace(/[\u0300-\u036f]/g, '')
     .replace(/[đĐ]/g, 'd')
     .toLocaleLowerCase('vi-VN');
   search.addEventListener('input', () => {
     const keyword = boDau(search.value.trim());
     let visible = 0;
     cards.forEach(card => {
       const match = boDau(card.dataset.search).includes(keyword);
       card.hidden = !match;
       if (match) visible++;
     });
     count.textContent = String(visible);
     empty.hidden = visible > 0;
   });
 })();
</script>
}
