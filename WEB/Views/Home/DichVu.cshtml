@model IEnumerable<QuanLyKhachSan.Web.Models.DichVuKhachViewModel>
@{
    ViewData["Title"] = "Dịch vụ khách sạn";
    ViewData["NavbarOverlay"] = false;
    var services = Model?.ToList() ?? new();
}

<section class="luxe-page">
    <div class="container">
        <header class="luxe-page-head">
            <div class="luxe-kicker mb-2">SAWADE SERVICES</div>
            <h1 class="luxe-title display-6 fw-bold mb-3">Những tiện ích làm kỳ nghỉ trọn vẹn hơn</h1>
            <p class="luxe-lead mb-0">Khám phá các dịch vụ và mức giá tham khảo đang được đồng bộ trực tiếp từ hệ thống khách sạn.</p>
        </header>

        @if (ViewBag.ApiError != null)
        {
            <div class="alert alert-warning rounded-4" role="alert">
                <i class="bi bi-wifi-off me-2"></i>@ViewBag.ApiError
                <a asp-controller="Home" asp-action="DichVu" class="alert-link ms-2">Thử tải lại</a>
            </div>
        }

        @if (services.Any())
        {
            <div class="row justify-content-between align-items-end g-3 mb-4">
                <div class="col-md-6 col-lg-5">
                    <label class="form-label fw-semibold" for="serviceSearch">Tìm dịch vụ</label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input id="serviceSearch" type="search" class="form-control border-start-0" placeholder="Ví dụ: ăn sáng, giặt ủi..." />
                    </div>
                </div>
                <div class="col-md-auto text-muted small"><span id="serviceCount" class="fw-bold text-dark">@services.Count</span> dịch vụ đang hiển thị</div>
            </div>

            <div class="row g-4" id="servicesGrid">
                @foreach (var service in services)
                {
                    <div class="col-md-6 col-xl-4 service-item" data-search="@(HienThiDichVu.Ten(service.TenDichVu) + " " + HienThiDichVu.MoTa(service.MoTa))">
                        <article class="service-luxe-card">
                            <div class="service-luxe-icon mb-4"><i class="bi @HienThiDichVu.Icon(service.TenDichVu)"></i></div>
                            <div class="luxe-kicker mb-2">HOTEL SERVICE</div>
                            <h2 class="h4 fw-bold mb-2">@HienThiDichVu.Ten(service.TenDichVu)</h2>
                            @if (!string.IsNullOrWhiteSpace(service.MoTa))
                            {
                                <p class="text-muted small mb-4">@HienThiDichVu.MoTa(service.MoTa)</p>
                            }
                            <div class="border-top mt-auto pt-3 d-flex justify-content-between align-items-end gap-3">
                                <span class="small text-muted">Giá tham khảo</span>
                                <strong class="text-end" style="color:#8f6834">@service.DonGia.ToString("N0") đ<br /><span class="small fw-normal text-muted">/ @HienThiDichVu.DonVi(service.DonViTinh)</span></strong>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <div class="alert alert-light border rounded-4 mt-4 small text-muted">
                <i class="bi bi-info-circle me-2"></i>Dịch vụ phát sinh được nhân viên khách sạn ghi nhận và thanh toán theo đơn thực tế. Trang này chỉ giới thiệu danh mục dịch vụ, chưa hỗ trợ đặt dịch vụ trực tuyến.
            </div>
            <div id="noServices" class="alert alert-light border rounded-4 mt-4" hidden>Không tìm thấy dịch vụ phù hợp với từ khóa.</div>
        }
        else if (ViewBag.ApiError == null)
        {
            <div class="service-luxe-card text-center p-5 mx-auto" style="max-width:680px">
                <i class="bi bi-bag-x display-5 text-muted"></i>
                <h2 class="h5 mt-3">Chưa có dịch vụ để hiển thị</h2>
                <p class="text-muted mb-0">Danh mục dịch vụ đang được cập nhật.</p>
            </div>
        }

        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-primary rounded-pill px-4 py-3">Khám phá phòng nghỉ <i class="bi bi-arrow-right ms-1"></i></a>
        </div>
    </div>
</section>

@section Scripts {
<script>
 (() => {
   const search = document.getElementById('serviceSearch');
   if (!search) return;
   const cards = [...document.querySelectorAll('.service-item')];
   const count = document.getElementById('serviceCount');
   const empty = document.getElementById('noServices');
   const boDau = text => (text || '')
     .normalize('NFD')
     .replace(/[\u0300-\u036f]/g, '')
     .replace(/[đĐ]/g, 'd')
     .toLocaleLowerCase('vi-VN');
   search.addEventListener('input', () => {
     const keyword = boDau(search.value.trim());
     let visible = 0;
     cards.forEach(card => {
       const match = boDau(card.dataset.search).includes(keyword);
       card.hidden = !match;
       if (match) visible++;
     });
     count.textContent = String(visible);
     empty.hidden = visible > 0;
   });
 })();
</script>
}
