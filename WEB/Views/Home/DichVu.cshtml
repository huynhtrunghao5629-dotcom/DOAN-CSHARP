@model IEnumerable<QuanLyKhachSan.Web.Models.DichVuKhachViewModel>
@{
    ViewData["Title"] = "Dịch vụ khách sạn";
    ViewData["NavbarOverlay"] = false;
    var services = Model?.ToList() ?? new();
}

@section Styles {
    <style>
        .services-toolbar {
            padding: 20px 24px;
            border: 1px solid var(--sawade-line);
            border-radius: 20px;
            background: var(--sawade-ivory-50);
            box-shadow: var(--sawade-shadow-xs);
        }

        .services-count-pill {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 9px 16px;
            border-radius: 999px;
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line);
            color: var(--sawade-forest-900);
            font-size: 0.84rem;
            font-weight: 600;
        }

        .service-luxe-card {
            display: flex;
            flex-direction: column;
        }

        .service-price-val {
            color: var(--sawade-gold-600);
            font-size: 1.18rem;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            line-height: 1.2;
        }

        .service-unit-text {
            font-size: 0.78rem;
            font-weight: 500;
            color: var(--sawade-muted);
        }

        .services-note-box {
            padding: 18px 22px;
            border-radius: 18px;
            border: 1px solid var(--sawade-line);
            background: var(--sawade-ivory-50);
            color: var(--sawade-muted);
            font-size: 0.88rem;
        }
    </style>
}

<section class="luxe-page">
    <div class="container">
        <header class="luxe-page-head">
            <div class="luxe-kicker mb-2">SAWADE SERVICES</div>
            <h1 class="luxe-title display-6 mb-3">Những tiện ích làm kỳ nghỉ trọn vẹn hơn</h1>
            <p class="luxe-lead mb-0">Khám phá các dịch vụ và mức giá tham khảo đang được đồng bộ trực tiếp từ hệ thống khách sạn.</p>
        </header>

        @if (ViewBag.ApiError != null)
        {
            <div class="alert alert-warning rounded-4 mb-4" role="alert">
                <i class="bi bi-wifi-off me-2" aria-hidden="true"></i>@ViewBag.ApiError
                <a asp-controller="Home" asp-action="DichVu" class="alert-link ms-2">Thử tải lại</a>
            </div>
        }

        @if (services.Any())
        {
            <div class="services-toolbar mb-4">
                <div class="row justify-content-between align-items-center g-3">
                    <div class="col-md-7 col-lg-5">
                        <label class="form-label mb-1" for="serviceSearch">Tìm kiếm dịch vụ</label>
                        <div class="input-group">
                            <span class="input-group-text border-end-0"><i class="bi bi-search" aria-hidden="true"></i></span>
                            <input id="serviceSearch" type="search" class="form-control border-start-0" placeholder="Ví dụ: ăn sáng, giặt ủi, đưa đón..." />
                        </div>
                    </div>
                    <div class="col-md-auto">
                        <span class="services-count-pill">
                            <i class="bi bi-grid-3x3-gap text-gold" aria-hidden="true"></i>
                            <span id="serviceCount">@services.Count</span> dịch vụ đang hiển thị
                        </span>
                    </div>
                </div>
            </div>

            <div class="row g-4" id="servicesGrid">
                @foreach (var service in services)
                {
                    <div class="col-md-6 col-xl-4 service-item" data-search="@(HienThiDichVu.Ten(service.TenDichVu) + " " + HienThiDichVu.MoTa(service.MoTa))">
                        <article class="service-luxe-card h-100">
                            <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
                                <div class="service-luxe-icon">
                                    <i class="bi @HienThiDichVu.Icon(service.TenDichVu)" aria-hidden="true"></i>
                                </div>
                                <span class="luxe-kicker">HOTEL SERVICE</span>
                            </div>

                            <h2 class="h5 fw-bold mb-2">@HienThiDichVu.Ten(service.TenDichVu)</h2>

                            @if (!string.IsNullOrWhiteSpace(service.MoTa))
                            {
                                <p class="text-muted small mb-4">@HienThiDichVu.MoTa(service.MoTa)</p>
                            }
                            else
                            {
                                <p class="text-muted small mb-4">Dịch vụ đi kèm phục vụ trực tiếp tại phòng hoặc khu vực tiện ích khách sạn.</p>
                            }

                            <div class="border-top mt-auto pt-3 d-flex justify-content-between align-items-end gap-3">
                                <span class="small text-muted">Giá tham khảo</span>
                                <div class="text-end">
                                    <div class="service-price-val">@service.DonGia.ToString("N0") đ</div>
                                    <div class="service-unit-text">/ @HienThiDichVu.DonVi(service.DonViTinh)</div>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>

            <div id="noServices" class="bg-white border rounded-4 p-5 text-center mt-4" hidden>
                <div class="sawade-empty-icon mb-3"><i class="bi bi-search" aria-hidden="true"></i></div>
                <h2 class="h5 fw-bold mb-1">Không tìm thấy dịch vụ phù hợp</h2>
                <p class="text-muted small mb-0">Hãy thử từ khóa ngắn hơn hoặc xóa ô tìm kiếm để xem toàn bộ danh mục.</p>
            </div>

            <div class="services-note-box mt-4 d-flex align-items-start gap-3">
                <i class="bi bi-info-circle-fill text-gold fs-5 mt-1" aria-hidden="true"></i>
                <div>
                    Dịch vụ phát sinh được lễ tân ghi nhận trực tiếp vào đơn đặt phòng và thanh toán khi trả phòng. Trang này dùng để tra cứu danh mục và bảng giá tham khảo, chưa hỗ trợ đặt dịch vụ riêng trực tuyến.
                </div>
            </div>
        }
        else if (ViewBag.ApiError == null)
        {
            <div class="service-luxe-card text-center p-5 mx-auto" style="max-width: 640px;">
                <div class="sawade-empty-icon mb-3"><i class="bi bi-bag-x" aria-hidden="true"></i></div>
                <h2 class="h5 fw-bold mt-2">Chưa có dịch vụ để hiển thị</h2>
                <p class="text-muted mb-0">Danh mục dịch vụ đang được cập nhật trên hệ thống.</p>
            </div>
        }

        <div class="text-center mt-5">
            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-primary rounded-pill px-4 py-3">
                Khám phá phòng nghỉ <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>

@section Scripts {
<script>
 (() => {
   const search = document.getElementById('serviceSearch');
   if (!search) return;
   const cards = [...document.querySelectorAll('.service-item')];
   const count = document.getElementById('serviceCount');
   const empty = document.getElementById('noServices');
   const boDau = text => (text || '')
     .normalize('NFD')
     .replace(/[\u0300-\u036f]/g, '')
     .replace(/[đĐ]/g, 'd')
     .toLocaleLowerCase('vi-VN');
   search.addEventListener('input', () => {
     const keyword = boDau(search.value.trim());
     let visible = 0;
     cards.forEach(card => {
       const match = boDau(card.dataset.search).includes(keyword);
       card.hidden = !match;
       if (match) visible++;
     });
     count.textContent = String(visible);
     empty.hidden = visible > 0;
   });
 })();
</script>
}
