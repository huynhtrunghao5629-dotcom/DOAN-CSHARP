@model IEnumerable<QuanLyKhachSan.Web.Models.PhongViewModel>

@{
    ViewData["Title"] = "Danh sách phòng";
    ViewData["NavbarOverlay"] = false;

    var rooms = Model?.ToList() ?? new List<QuanLyKhachSan.Web.Models.PhongViewModel>();
    int? selectedRoomType = ViewBag.LoaiPhong as int?;
    var roomTypes = ViewBag.DanhSachLoaiPhong as List<QuanLyKhachSan.Web.Models.LoaiPhongViewModel> ?? new();
    int? selectedGuests = ViewBag.SoKhach as int?;
    string? searchKeyword = ViewBag.TuKhoa as string;
    int totalRooms = ViewBag.TongSoPhong is int resultCount ? resultCount : rooms.Count;
    int totalPages = ViewBag.TongSoTrang is int countPage ? countPage : 0;
    int currentPage = ViewBag.TrangHienTai is int pageNum ? pageNum : 1;
    bool searchedDates = ViewBag.FilterError == null && (ViewBag.NgayNhan as DateOnly?).HasValue && (ViewBag.NgayTra as DateOnly?).HasValue;
    decimal priceFrom = ViewBag.GiaTu is decimal minPrice ? minPrice : 0;
    decimal priceTo = ViewBag.GiaDen is decimal maxPrice ? maxPrice : 10000000;
    DateOnly? selectedCheckIn = ViewBag.NgayNhan as DateOnly?;
    DateOnly? selectedCheckOut = ViewBag.NgayTra as DateOnly?;
    string? currentSort = ViewBag.SapXepGia as string;

    string? strCheckIn = selectedCheckIn?.ToString("yyyy-MM-dd");
    string? strCheckOut = selectedCheckOut?.ToString("yyyy-MM-dd");

    int appliedFilters = (selectedRoomType.HasValue ? 1 : 0)
        + (selectedGuests.HasValue ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(searchKeyword) ? 1 : 0)
        + ((ViewBag.GiaTu != null || ViewBag.GiaDen != null) ? 1 : 0)
        + ((selectedCheckIn.HasValue || selectedCheckOut.HasValue) ? 1 : 0)
        + (ViewBag.ChiPhongTrong == true ? 1 : 0)
        + (!string.IsNullOrWhiteSpace(currentSort) ? 1 : 0);

    var selectedTypeName = selectedRoomType.HasValue
        ? roomTypes.FirstOrDefault(t => t.LoaiPhongId == selectedRoomType.Value)?.TenLoai
        : null;

    var fallbackImgs = new[]
    {
        Url.Content("~/images/102.jpg"),
        Url.Content("~/images/201.jpg"),
        Url.Content("~/images/208.jpg"),
        Url.Content("~/images/301.jpg"),
        Url.Content("~/images/106.jpg")
    };
}

@section Styles {
    <style>
        .rooms-page {
            min-height: 82vh;
            padding: 52px 0 92px;
        }

        .rooms-filter {
            position: sticky;
            top: 102px;
            padding: 28px 24px;
            background: var(--sawade-ivory-50);
            border: 1px solid var(--sawade-line-strong);
            border-top: 2px solid var(--sawade-forest-900);
        }

        .filter-section {
            padding-bottom: 18px;
            margin-bottom: 18px;
            border-bottom: 1px solid var(--sawade-line);
        }

        .filter-section:last-of-type {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .filter-count-tag {
            padding: 3px 9px;
            background: var(--sawade-forest-900);
            color: var(--sawade-gold-300);
            font-size: 0.66rem;
            font-weight: 600;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .rooms-header-bar {
            padding-bottom: 24px;
            margin-bottom: 26px;
            border-bottom: 1px solid var(--sawade-line-strong);
        }

        .rooms-stat-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 14px;
            background: var(--sawade-ivory-50);
            border: 1px solid var(--sawade-line-strong);
            color: var(--sawade-forest-900);
            font-size: 0.74rem;
            font-weight: 500;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .active-filter-bar {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px;
            margin-bottom: 22px;
        }

        .active-filter-chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            background: var(--sawade-ivory-50);
            border: 1px solid var(--sawade-gold-500);
            color: var(--sawade-forest-950);
            font-size: 0.75rem;
            font-weight: 500;
        }

        .rooms-page .room-content {
            padding: 22px 22px 24px;
            display: flex;
            flex-direction: column;
            flex: 1;
        }

        .rooms-page .room-type-pill {
            position: absolute;
            top: 14px;
            left: 14px;
            padding: 5px 11px;
            background: rgba(252, 251, 248, 0.94);
            color: var(--sawade-forest-950);
            font-size: 0.66rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .rooms-price-range-box {
            padding: 14px;
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line);
        }

        .rooms-page .form-switch .form-check-input {
            width: 2.35em;
            height: 1.2em;
            border-radius: 0;
            cursor: pointer;
        }

        .rooms-page .form-switch .form-check-input:checked {
            background-color: var(--sawade-forest-900);
            border-color: var(--sawade-forest-900);
        }

        @@media (max-width: 991.98px) {
            .rooms-filter {
                position: static;
            }
        }
    </style>
}

<div class="rooms-page">
    <div class="container">
        <div class="row g-4 g-xl-5 align-items-start">
            <!-- CỘT BỘ LỌC BÊN TRÁI -->
            <aside class="col-lg-3">
                <div class="rooms-filter">
                    <div class="d-flex justify-content-between align-items-center gap-2 mb-1">
                        <h2 class="editorial-serif h4 mb-0">Bộ lọc phòng</h2>
                        @if (appliedFilters > 0)
                        {
                            <span class="filter-count-tag">@appliedFilters lọc</span>
                        }
                    </div>
                    <p class="text-muted small mb-4">Tinh chỉnh hạng phòng, khoảng giá và lịch lưu trú.</p>

                    <form method="get" asp-controller="Home" asp-action="DanhSachPhong" data-sawade-busy="Đang lọc phòng...">
                        <div class="filter-section">
                            <div class="mb-3">
                                <label class="form-label" for="filterKeyword">Tìm kiếm nhanh</label>
                                <input id="filterKeyword" name="tuKhoa" type="search" class="form-control" placeholder="Số phòng (101) hoặc hạng phòng..." value="@searchKeyword" maxlength="80" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="filterRoomType">Hạng phòng</label>
                                <select id="filterRoomType" name="loaiPhong" class="form-select">
                                    <option value="">Tất cả hạng phòng</option>
                                    @foreach (var roomType in roomTypes)
                                    {
                                        <option value="@roomType.LoaiPhongId" selected="@(selectedRoomType == roomType.LoaiPhongId)">@HienThiPhong.TenLoai(roomType.TenLoai)</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="filterGuests">Số khách lưu trú</label>
                                <select id="filterGuests" name="soKhach" class="form-select">
                                    <option value="">Không giới hạn số khách</option>
                                    @for (int guestCount = 1; guestCount <= 10; guestCount++)
                                    {
                                        <option value="@guestCount" selected="@(selectedGuests == guestCount)">@guestCount người</option>
                                    }
                                </select>
                            </div>

                            <div>
                                <label class="form-label" for="filterSortPrice">Sắp xếp theo giá</label>
                                <select id="filterSortPrice" name="sapXepGia" class="form-select">
                                    <option value="">Mặc định</option>
                                    <option value="tang" selected="@(ViewBag.SapXepGia == "tang")">Giá từ thấp đến cao</option>
                                    <option value="giam" selected="@(ViewBag.SapXepGia == "giam")">Giá từ cao đến thấp</option>
                                </select>
                            </div>
                        </div>

                        <div class="filter-section">
                            <label class="form-label">Khoảng giá mỗi đêm (VND)</label>
                            <div class="rooms-price-range-box">
                                <div class="row g-2 mb-3">
                                    <div class="col-6">
                                        <input type="text" id="displayGiaTu" class="form-control form-control-sm" placeholder="Từ..." value="@(ViewBag.GiaTu != null ? ((decimal)ViewBag.GiaTu).ToString("#,##0") : "")" aria-label="Giá tối thiểu" />
                                    </div>
                                    <div class="col-6">
                                        <input type="text" id="displayGiaDen" class="form-control form-control-sm" placeholder="Đến..." value="@(ViewBag.GiaDen != null ? ((decimal)ViewBag.GiaDen).ToString("#,##0") : "")" aria-label="Giá tối đa" />
                                    </div>
                                </div>

                                <input type="hidden" name="giaTu" id="giaTu" value="@(ViewBag.GiaTu is decimal p1 ? p1.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />
                                <input type="hidden" name="giaDen" id="giaDen" value="@(ViewBag.GiaDen is decimal p2 ? p2.ToString(System.Globalization.CultureInfo.InvariantCulture) : "")" />

                                <label class="text-muted d-block mb-1" for="sliderGiaTu" style="font-size: 0.72rem;">Mức giá TỪ:</label>
                                <input type="range" class="form-range" id="sliderGiaTu" min="0" max="10000000" step="100000" value="@priceFrom.ToString(System.Globalization.CultureInfo.InvariantCulture)">

                                <label class="text-muted d-block mt-2 mb-1" for="sliderGiaDen" style="font-size: 0.72rem;">Mức giá ĐẾN:</label>
                                <input type="range" class="form-range" id="sliderGiaDen" min="0" max="10000000" step="100000" value="@priceTo.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            </div>
                        </div>

                        <div class="filter-section">
                            <div class="mb-3">
                                <label class="form-label" for="filterCheckIn">Ngày nhận phòng</label>
                                <input id="filterCheckIn" type="date" name="ngayNhan" class="form-control" min="@(DateTime.Today.ToString("yyyy-MM-dd"))" value="@strCheckIn" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label" for="filterCheckOut">Ngày trả phòng</label>
                                <input id="filterCheckOut" type="date" name="ngayTra" class="form-control" min="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" value="@strCheckOut" />
                            </div>

                            <div class="form-check form-switch d-flex align-items-center gap-2 ps-5 mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" name="chiPhongTrong" value="true" id="checkPhongTrong" @(ViewBag.ChiPhongTrong == true ? "checked" : "")>
                                <label class="form-check-label small fw-medium" for="checkPhongTrong">Chỉ hiển thị phòng trống</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-sawade-primary py-2.5">
                                Áp dụng bộ lọc
                            </button>
                            @if (appliedFilters > 0)
                            {
                                <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-light py-2">
                                    Xóa bộ lọc
                                </a>
                            }
                        </div>
                    </form>
                </div>
            </aside>

            <!-- CỘT DANH SÁCH PHÒNG BÊN PHẢI -->
            <section class="col-lg-9" aria-labelledby="roomsHeading">
                <div class="rooms-header-bar d-flex flex-wrap justify-content-between align-items-end gap-3">
                    <div>
                        <span class="section-eyebrow d-block mb-2">SAWADE &middot; ROOMS &amp; SUITES</span>
                        <h1 id="roomsHeading" class="section-heading mb-2">Không gian nghỉ dưỡng</h1>
                        <p class="luxe-lead mb-0">Lựa chọn căn phòng phù hợp nhất với lịch trình và ngân sách của bạn.</p>
                    </div>
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="rooms-stat-tag">
                            <strong class="tabular-nums">@totalRooms</strong> phòng
                        </span>
                        <span class="rooms-stat-tag tabular-nums">
                            Trang @currentPage / @Math.Max(1, totalPages)
                        </span>
                    </div>
                </div>

                @if (appliedFilters > 0)
                {
                    <div class="active-filter-bar" aria-label="Bộ lọc đang áp dụng">
                        @if (!string.IsNullOrWhiteSpace(selectedTypeName))
                        {
                            <span class="active-filter-chip">@HienThiPhong.TenLoai(selectedTypeName)</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(searchKeyword))
                        {
                            <span class="active-filter-chip">Từ khóa: "@searchKeyword"</span>
                        }
                        @if (selectedGuests.HasValue)
                        {
                            <span class="active-filter-chip">@selectedGuests khách</span>
                        }
                        @if (ViewBag.GiaTu != null || ViewBag.GiaDen != null)
                        {
                            <span class="active-filter-chip tabular-nums">
                                @(ViewBag.GiaTu != null ? ((decimal)ViewBag.GiaTu).ToString("#,##0") + " đ" : "0 đ") – @(ViewBag.GiaDen != null ? ((decimal)ViewBag.GiaDen).ToString("#,##0") + " đ" : "10.000.000 đ")
                            </span>
                        }
                        @if (searchedDates)
                        {
                            <span class="active-filter-chip tabular-nums">@selectedCheckIn?.ToString("dd/MM/yyyy") &rarr; @selectedCheckOut?.ToString("dd/MM/yyyy")</span>
                        }
                        @if (ViewBag.ChiPhongTrong == true)
                        {
                            <span class="active-filter-chip">Chỉ phòng trống</span>
                        }
                        <a asp-controller="Home" asp-action="DanhSachPhong" class="small text-decoration-none fw-semibold ms-1" style="color: var(--sawade-gold-600);">Đặt lại</a>
                    </div>
                }

                @if (searchedDates)
                {
                    <div class="alert alert-light border small mb-4" style="border-left: 3px solid var(--sawade-gold-500) !important;" role="status">
                        Đang hiển thị các phòng trống từ <strong>@selectedCheckIn?.ToString("dd/MM/yyyy")</strong> đến <strong>@selectedCheckOut?.ToString("dd/MM/yyyy")</strong>. Lịch thực tế sẽ được xác minh lần cuối khi bạn gửi yêu cầu đặt phòng.
                    </div>
                }
                @if (ViewBag.FilterNotice != null)
                {
                    <div class="alert alert-info mb-4" role="status">@ViewBag.FilterNotice</div>
                }
                @if (ViewBag.FilterError != null)
                {
                    <div class="alert alert-warning mb-4" role="alert">
                        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>@ViewBag.FilterError
                    </div>
                }
                @if (ViewBag.ApiError != null)
                {
                    <div class="alert alert-danger mb-4" role="alert">
                        <i class="bi bi-wifi-off me-2" aria-hidden="true"></i>@ViewBag.ApiError
                        <a href="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" class="alert-link ms-2">Thử tải lại</a>
                    </div>
                }

                @if (rooms.Any())
                {
                    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
                        @foreach (var room in rooms)
                        {
                            var roomNumber = (room.SoPhong ?? string.Empty).Trim();
                            var storedImage = (room.HinhAnh ?? string.Empty).Trim();
                            var localImage = string.IsNullOrWhiteSpace(storedImage)
                                ? Url.Content("~/images/" + roomNumber + ".jpg")
                                : (storedImage.StartsWith("/") ? Url.Content("~" + storedImage) : Url.Content("~/images/" + storedImage));
                            var fallbackIndex = (int)(Math.Abs((long)room.PhongId) % fallbackImgs.Length);
                            var fallback = fallbackImgs[fallbackIndex];

                            var statusText = searchedDates ? "Trống theo ngày chọn" : HienThiPhong.TrangThai(room.TrangThai);
                            var isAvailable = searchedDates || HienThiPhong.DangTrong(room.TrangThai);
                            var isOccupied = statusText == "Đang có khách";
                            var statusClass = isAvailable ? "available" : isOccupied ? "occupied" : "unavailable";

                            <div class="col">
                                <article class="room-card h-100 d-flex flex-column">
                                    <div class="room-image-wrapper">
                                        <img src="@localImage"
                                             alt="Ảnh phòng @room.SoPhong"
                                             loading="lazy" decoding="async"
                                             onerror="this.onerror=null;this.src='@fallback';" />
                                        <span class="room-type-pill">@HienThiPhong.TenLoai(room.TenLoaiPhong)</span>
                                    </div>
                                    <div class="room-content">
                                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                            <h2 class="editorial-serif mb-0" style="font-size: 1.5rem; color: var(--sawade-forest-950);">Phòng @room.SoPhong</h2>
                                            <span class="room-status @statusClass">@statusText</span>
                                        </div>

                                        <div class="text-muted small mb-4 d-flex flex-column gap-1 mt-1">
                                            <span>@HienThiPhong.TenLoai(room.TenLoaiPhong)</span>
                                            @if (room.SoNguoiToiDa.HasValue)
                                            {
                                                <span>Sức chứa tối đa @room.SoNguoiToiDa người</span>
                                            }
                                        </div>

                                        <div class="border-top pt-3 mt-auto d-flex justify-content-between align-items-end gap-2">
                                            <div>
                                                <div class="text-muted" style="font-size: 0.66rem; letter-spacing: 0.12em; text-transform: uppercase;">Giá mỗi đêm</div>
                                                <div class="room-price">@room.GiaPhong.ToString("#,##0") đ</div>
                                            </div>
                                            <a asp-controller="Home" asp-action="ChiTietPhong"
                                               asp-route-id="@room.PhongId"
                                               asp-route-ngayNhan="@strCheckIn"
                                               asp-route-ngayTra="@strCheckOut"
                                               asp-route-soKhach="@selectedGuests"
                                               class="btn btn-sawade-primary btn-sm">
                                                Xem phòng
                                            </a>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>

                    @if (totalPages > 1)
                    {
                        <nav aria-label="Điều hướng trang" class="mt-5">
                            <ul class="pagination justify-content-center gap-1 custom-pagination mb-0">
                                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("DanhSachPhong", "Home", new {
                                        trang = currentPage - 1,
                                        sapXepGia = ViewBag.SapXepGia,
                                        loaiPhong = ViewBag.LoaiPhong,
                                        giaTu = ViewBag.GiaTu,
                                        giaDen = ViewBag.GiaDen,
                                        chiPhongTrong = ViewBag.ChiPhongTrong,
                                        ngayNhan = strCheckIn,
                                        ngayTra = strCheckOut,
                                        soKhach = selectedGuests,
                                        tuKhoa = searchKeyword
                                    })">
                                        <i class="bi bi-chevron-left me-1" aria-hidden="true"></i>Trước
                                    </a>
                                </li>

                                @for (int i = 1; i <= totalPages; i++)
                                {
                                    <li class="page-item @(currentPage == i ? "active" : "")">
                                        <a class="page-link" href="@Url.Action("DanhSachPhong", "Home", new {
                                            trang = i,
                                            sapXepGia = ViewBag.SapXepGia,
                                            loaiPhong = ViewBag.LoaiPhong,
                                            giaTu = ViewBag.GiaTu,
                                            giaDen = ViewBag.GiaDen,
                                            chiPhongTrong = ViewBag.ChiPhongTrong,
                                            ngayNhan = strCheckIn,
                                            ngayTra = strCheckOut,
                                            soKhach = selectedGuests,
                                            tuKhoa = searchKeyword
                                        })">@i</a>
                                    </li>
                                }

                                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                    <a class="page-link" href="@Url.Action("DanhSachPhong", "Home", new {
                                        trang = currentPage + 1,
                                        sapXepGia = ViewBag.SapXepGia,
                                        loaiPhong = ViewBag.LoaiPhong,
                                        giaTu = ViewBag.GiaTu,
                                        giaDen = ViewBag.GiaDen,
                                        chiPhongTrong = ViewBag.ChiPhongTrong,
                                        ngayNhan = strCheckIn,
                                        ngayTra = strCheckOut,
                                        soKhach = selectedGuests,
                                        tuKhoa = searchKeyword
                                    })">
                                        Sau<i class="bi bi-chevron-right ms-1" aria-hidden="true"></i>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    }
                }
                else
                {
                    <div class="bg-white p-5 text-center border">
                        <div class="sawade-empty-icon mb-3"><i class="bi bi-house-x" aria-hidden="true"></i></div>
                        <h2 class="editorial-serif h4">@(ViewBag.ApiError != null ? "Chưa thể tải danh sách phòng" : "Chưa tìm thấy phòng phù hợp")</h2>
                        <p class="text-muted mb-4">@(ViewBag.ApiError != null ? "Kết nối đến hệ thống phòng bị gián đoạn. Vui lòng thử tải lại." : "Hãy thử nới rộng khoảng giá, đổi ngày lưu trú hoặc bỏ bớt tiêu chí lọc.")</p>
                        @if (ViewBag.ApiError != null)
                        {
                            <a href="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" class="btn btn-sawade-primary">Thử tải lại</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-light">Xóa toàn bộ bộ lọc</a>
                        }
                    </div>
                }
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const checkIn = document.getElementById('filterCheckIn');
            const checkOut = document.getElementById('filterCheckOut');
            if (checkIn && checkOut) {
                checkIn.addEventListener('change', () => {
                    if (!checkIn.value) return;
                    const date = new Date(`${checkIn.value}T00:00:00`);
                    date.setDate(date.getDate() + 1);
                    const nextDay = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
                    checkOut.min = nextDay;
                    if (checkOut.value && checkOut.value <= checkIn.value) checkOut.value = nextDay;
                });
            }

            const formatCurrency = (num) => {
                if (!num && num !== 0 && num !== '0') return '';
                const parsed = parseInt(num, 10);
                return Number.isNaN(parsed) ? '' : parsed.toLocaleString('vi-VN');
            };

            const parseCurrency = (str) => {
                if (!str) return '';
                return str.replace(/\./g, '').replace(/,/g, '').replace(/\D/g, '');
            };

            const setupPriceInput = (displayId, hiddenId, sliderId) => {
                const display = document.getElementById(displayId);
                const hidden = document.getElementById(hiddenId);
                const slider = document.getElementById(sliderId);
                if (!display || !hidden || !slider) return;

                slider.addEventListener('input', (e) => {
                    const val = e.target.value;
                    hidden.value = val;
                    display.value = formatCurrency(val);
                });

                display.addEventListener('input', (e) => {
                    const rawValue = parseCurrency(e.target.value);
                    hidden.value = rawValue;
                    display.value = formatCurrency(rawValue);
                    if (rawValue && !isNaN(rawValue)) {
                        slider.value = rawValue;
                    }
                });
            };

            setupPriceInput('displayGiaTu', 'giaTu', 'sliderGiaTu');
            setupPriceInput('displayGiaDen', 'giaDen', 'sliderGiaDen');

            const form = document.querySelector('.rooms-filter form');
            form?.addEventListener('submit', (e) => {
                const min = Number(document.getElementById('giaTu')?.value || 0);
                const maxValue = document.getElementById('giaDen')?.value;
                const max = maxValue ? Number(maxValue) : null;

                if (max !== null && min > max) {
                    e.preventDefault();
                    alert('Giá tối thiểu không được lớn hơn giá tối đa.');
                    document.getElementById('displayGiaDen')?.focus();
                } else if (checkIn && checkOut && checkIn.value !== '' && checkOut.value !== '' && checkOut.value <= checkIn.value) {
                    e.preventDefault();
                    alert('Ngày trả phòng phải sau ngày nhận phòng.');
                    checkOut.focus();
                }
            });
        })();
    </script>
}
