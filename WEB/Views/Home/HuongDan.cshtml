@{
    ViewData["Title"] = "Hướng dẫn đặt phòng";
    ViewData["NavbarOverlay"] = false;
}

@section Styles {
    <style>
        .guide-timeline {
            border-top: 1px solid var(--sawade-line-strong);
            border-bottom: 1px solid var(--sawade-line-strong);
            background: var(--sawade-ivory-50);
        }

        .guide-step-col {
            padding: 36px 32px;
            border-right: 1px solid var(--sawade-line);
        }

        .guide-step-col:last-child {
            border-right: 0;
        }

        .guide-tip-card {
            padding: 24px 26px;
            border: 1px solid var(--sawade-line-strong);
            border-left: 3px solid var(--sawade-gold-500);
            background: var(--sawade-ivory-50);
        }

        .accordion-body {
            color: var(--sawade-ink-soft);
            font-size: 0.91rem;
            line-height: 1.78;
            padding: 0.5rem 0.5rem 1.4rem;
        }

        @@media (max-width: 767.98px) {
            .guide-step-col {
                border-right: 0;
                border-bottom: 1px solid var(--sawade-line);
                padding: 26px 20px;
            }
            .guide-step-col:last-child {
                border-bottom: 0;
            }
        }
    </style>
}

<section class="luxe-page">
    <div class="container" style="max-width: 1080px;">
        <header class="luxe-page-head">
            <div class="luxe-kicker mb-2">GUEST CONCIERGE GUIDE</div>
            <h1 class="luxe-title mb-3">Đặt phòng SAWADE trong ba bước tinh gọn</h1>
            <div class="editorial-rule my-3"></div>
            <p class="luxe-lead mb-0">Từ lúc chọn ngày lưu trú đến khi theo dõi xác nhận, mọi thông tin đều minh bạch và đồng bộ trực tiếp trên website.</p>
        </header>

        <div class="guide-timeline row g-0 mb-5">
            <div class="col-md-4 guide-step-col">
                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="guide-step-number">01</span>
                    <span class="luxe-kicker">TRA CỨU</span>
                </div>
                <h2 class="editorial-serif h3 mb-2">Tìm &amp; lọc phòng</h2>
                <p class="text-muted small mb-0" style="line-height: 1.72;">Chọn ngày nhận, ngày trả, số khách, hạng phòng và khoảng giá để lọc chính xác những phòng còn trống theo lịch của bạn.</p>
            </div>
            <div class="col-md-4 guide-step-col">
                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="guide-step-number">02</span>
                    <span class="luxe-kicker">XÁC NHẬN</span>
                </div>
                <h2 class="editorial-serif h3 mb-2">Gửi yêu cầu đặt phòng</h2>
                <p class="text-muted small mb-0" style="line-height: 1.72;">Đăng nhập tài khoản thành viên, kiểm tra lịch đã đặt, xem tổng tiền tạm tính và gửi yêu cầu trực tiếp đến hệ thống.</p>
            </div>
            <div class="col-md-4 guide-step-col">
                <div class="d-flex justify-content-between align-items-baseline mb-4">
                    <span class="guide-step-number">03</span>
                    <span class="luxe-kicker">THEO DÕI</span>
                </div>
                <h2 class="editorial-serif h3 mb-2">Nhận mã &amp; In phiếu</h2>
                <p class="text-muted small mb-0" style="line-height: 1.72;">Nhận mã đơn ngay lập tức, theo dõi tiến độ duyệt của lễ tân và in phiếu thông tin khổ A4 trong mục Tài khoản của tôi.</p>
            </div>
        </div>

        <div class="row g-4 g-lg-5 align-items-start pt-3">
            <div class="col-lg-4">
                <div class="luxe-kicker mb-2">FREQUENTLY ASKED</div>
                <h2 class="editorial-serif h1 mb-3">Câu hỏi thường gặp</h2>
                <p class="luxe-lead small mb-4">Giải đáp nhanh những tình huống phổ biến trong quá trình tra cứu và đặt phòng tại SAWADE.</p>

                <div class="guide-tip-card">
                    <div class="luxe-kicker mb-2">LƯU Ý ĐẶT PHÒNG NHANH</div>
                    <p class="text-muted small mb-0" style="line-height: 1.7;">Đăng nhập tài khoản thành viên trước khi chọn phòng để hệ thống tự động điền thông tin liên hệ và lưu lịch sử đơn ngay lập tức.</p>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="accordion accordion-flush" id="sawadeFaq">
                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                                Làm sao biết đơn đã được xác nhận?
                            </button>
                        </h3>
                        <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#sawadeFaq">
                            <div class="accordion-body">
                                Đơn mới gửi sẽ có trạng thái <strong>Chờ xác nhận</strong>. Khi lễ tân tiếp nhận và duyệt trên phần mềm quản lý, trạng thái trên tài khoản của bạn sẽ tự động chuyển thành <strong>Đã đặt (đã xác nhận)</strong>.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                Tôi có thể hủy đơn đặt phòng không?
                            </button>
                        </h3>
                        <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#sawadeFaq">
                            <div class="accordion-body">
                                Trên website, nút tự hủy chỉ hiển thị đối với các đơn đang ở trạng thái <strong>Chờ xác nhận</strong>. Với các đơn đã xác nhận hoặc đang lưu trú, vui lòng liên hệ trực tiếp lễ tân để được hỗ trợ theo quy định.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                Tổng tiền hiển thị ở trang phòng là gì?
                            </button>
                        </h3>
                        <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#sawadeFaq">
                            <div class="accordion-body">
                                Đó là tiền phòng <strong>tạm tính</strong> dựa trên đơn giá niêm yết và số đêm lưu trú. Giá trị đơn chính thức được hệ thống ghi nhận sau khi đặt; các dịch vụ phát sinh trong quá trình ở sẽ được cộng riêng khi trả phòng.
                            </div>
                        </div>
                    </div>

                    <div class="accordion-item">
                        <h3 class="accordion-header">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                Tại sao tôi không thấy phòng trống theo ngày đã chọn?
                            </button>
                        </h3>
                        <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#sawadeFaq">
                            <div class="accordion-body">
                                Hãy thử thay đổi khoảng ngày lưu trú, điều chỉnh số lượng khách hoặc bấm <strong>Xóa bộ lọc</strong>. Nếu vẫn chưa thấy phòng, các hạng phòng bạn chọn có thể đã có lịch đặt trùng trong khoảng ngày đó.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="text-center mt-5 pt-3">
            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-primary btn-lg">
                Bắt đầu tìm phòng <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
            </a>
        </div>
    </div>
</section>
