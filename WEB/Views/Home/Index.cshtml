@model IEnumerable<QuanLyKhachSan.Web.Models.PhongViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Trang chủ";
    ViewData["NavbarOverlay"] = true;
    var rooms = Model?.ToList() ?? new List<QuanLyKhachSan.Web.Models.PhongViewModel>();

    var fallbackImgs = new[]
    {
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1618773928120-22165582f349?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=900&q=80"
    };
}

@section Styles {
    <style>
        .home-api-alert {
            position: relative;
            z-index: 1020;
            margin-top: 82px;
            border: 0;
            border-bottom: 1px solid rgba(184, 139, 74, 0.35);
            background: #FFF6E0;
            color: #5E420D;
            font-size: 0.9rem;
        }

        .home-search-divider {
            position: relative;
        }

        @@media (min-width: 992px) {
            .home-search-divider::before {
                content: "";
                position: absolute;
                left: 0;
                top: 16%;
                bottom: 16%;
                width: 1px;
                background: var(--sawade-line);
            }
        }

        .home-section-link {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.55rem 1.15rem;
            border-radius: 999px;
            border: 1px solid var(--sawade-line-strong);
            background: var(--sawade-ivory-50);
            color: var(--sawade-forest-900);
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
        }

        .home-section-link:hover {
            background: var(--sawade-forest-900);
            border-color: var(--sawade-forest-900);
            color: #fff;
            transform: translateY(-2px);
        }

        .home-category-card {
            position: relative;
            display: block;
            height: 310px;
            border-radius: 24px;
            overflow: hidden;
            border: 1px solid var(--sawade-line);
            background: var(--sawade-forest-950);
            box-shadow: var(--sawade-shadow-xs);
            text-decoration: none;
            transition: transform 0.3s var(--sawade-ease-out), box-shadow 0.3s var(--sawade-ease-out), border-color 0.25s ease;
        }

        .home-category-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s var(--sawade-ease-out);
        }

        .home-category-card:hover {
            transform: translateY(-5px);
            border-color: rgba(184, 139, 74, 0.42);
            box-shadow: var(--sawade-shadow-md);
        }

        .home-category-card:hover img {
            transform: scale(1.06);
        }

        .home-category-badge {
            position: absolute;
            top: 16px;
            left: 16px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(14, 34, 27, 0.72);
            border: 1px solid rgba(255, 255, 255, 0.22);
            color: var(--sawade-gold-300);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            font-size: 0.74rem;
            font-weight: 600;
        }

        .home-category-overlay {
            position: absolute;
            inset: auto 0 0;
            padding: 64px 22px 22px;
            background: linear-gradient(0deg, rgba(10, 24, 19, 0.92) 0%, rgba(10, 24, 19, 0.45) 58%, transparent 100%);
            color: #fff;
        }

        .home-category-overlay h3 {
            font-family: var(--sawade-font-display);
            font-size: 1.5rem;
            line-height: 1.2;
            color: #fff;
            margin-bottom: 6px;
        }

        .home-category-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            font-size: 0.84rem;
            color: rgba(255, 255, 255, 0.8);
        }

        .home-category-price {
            color: var(--sawade-gold-300);
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .home-room-badge {
            position: absolute;
            top: 14px;
            left: 14px;
            padding: 6px 12px;
            border-radius: 999px;
            background: rgba(255, 253, 249, 0.94);
            color: var(--sawade-forest-950);
            font-size: 0.75rem;
            font-weight: 600;
            box-shadow: 0 6px 16px rgba(14, 34, 27, 0.14);
        }

        .home-editorial-banner {
            position: relative;
            overflow: hidden;
            border-radius: 28px;
            padding: 44px 48px;
            background:
                radial-gradient(circle at 86% 18%, rgba(207, 166, 107, 0.22), transparent 22rem),
                linear-gradient(135deg, var(--sawade-forest-950) 0%, var(--sawade-forest-800) 100%);
            color: #fff;
            box-shadow: var(--sawade-shadow-md);
        }

        .home-editorial-banner h2 {
            font-family: var(--sawade-font-display);
            color: #fff;
            font-size: clamp(1.75rem, 2.8vw, 2.5rem);
            line-height: 1.2;
        }

        .home-editorial-banner p {
            color: rgba(255, 255, 255, 0.78);
            max-width: 560px;
        }

        @@media (max-width: 767.98px) {
            .home-category-card {
                height: 260px;
            }
            .home-editorial-banner {
                padding: 30px 24px;
                border-radius: 22px;
            }
        }
    </style>
}

@if (ViewBag.ApiError != null)
{
    <div class="alert home-api-alert text-center rounded-0 mb-0" role="alert">
        <i class="bi bi-wifi-off me-2" aria-hidden="true"></i>@ViewBag.ApiError
        <a asp-controller="Home" asp-action="Index" class="alert-link ms-2">Thử tải lại</a>
    </div>
}

<section class="hero-banner" style="background-image: url('https://images.unsplash.com/photo-1542314831-c6a4d27ce66f?q=80&w=2000&auto=format&fit=crop');">
    <div class="container hero-content">
        <div class="col-lg-8 col-xl-7 hero-copy">
            <p class="hero-eyebrow text-uppercase mb-3">SAWADE HOTELS &amp; RESORTS &middot; STAY DIFFERENT</p>

            <h1 class="hero-title mb-3">Chạm vào một nhịp nghỉ dưỡng khác biệt</h1>

            <p class="hero-description">
                Không chỉ là một căn phòng để dừng chân. SAWADE kiến tạo không gian yên tĩnh, chỉn chu và đủ riêng tư để mỗi kỳ nghỉ của bạn đều trọn vẹn.
            </p>

            <div class="hero-actions position-relative" style="z-index: 10;">
                <a asp-controller="Home" asp-action="DanhSachPhong" class="hero-cta-primary">
                    Tìm phòng phù hợp <i class="bi bi-arrow-up-right ms-2" aria-hidden="true"></i>
                </a>
                <a href="#loai-phong" class="hero-cta-secondary">
                    <i class="bi bi-compass me-2" aria-hidden="true"></i>Khám phá hạng phòng
                </a>
            </div>
        </div>
    </div>
</section>

<div class="search-shell container">
    <div class="floating-search-bar">
        <form asp-controller="Home" asp-action="DanhSachPhong" method="get" class="row align-items-center g-2" data-sawade-busy="Đang tìm phòng...">
            <div class="col-lg-2 col-md-12 px-lg-3 px-2 py-2">
                <label class="text-muted small fw-semibold mb-1 d-block">
                    <i class="bi bi-buildings me-1 text-gold" aria-hidden="true"></i>Điểm đến
                </label>
                <div class="fw-bold" style="color: var(--sawade-forest-950);">Khách sạn SAWADE</div>
                <div class="text-muted small">Phòng đồng bộ trực tiếp</div>
            </div>

            <div class="col-lg-3 col-md-4 col-6 home-search-divider px-lg-3 px-2 py-2">
                <label class="text-muted small fw-semibold mb-1 d-block" for="homeNgayNhan">
                    <i class="bi bi-calendar-check me-1 text-gold" aria-hidden="true"></i>Ngày nhận phòng
                </label>
                <input id="homeNgayNhan" type="date" name="ngayNhan" min="@(DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control search-input" required />
            </div>

            <div class="col-lg-3 col-md-4 col-6 home-search-divider px-lg-3 px-2 py-2">
                <label class="text-muted small fw-semibold mb-1 d-block" for="homeNgayTra">
                    <i class="bi bi-calendar-x me-1 text-gold" aria-hidden="true"></i>Ngày trả phòng
                </label>
                <input id="homeNgayTra" type="date" name="ngayTra" min="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" class="form-control search-input" required />
            </div>

            <div class="col-lg-2 col-md-4 col-12 home-search-divider px-lg-3 px-2 py-2">
                <label class="text-muted small fw-semibold mb-1 d-block" for="homeGuests">
                    <i class="bi bi-people me-1 text-gold" aria-hidden="true"></i>Số khách
                </label>
                <select id="homeGuests" name="soKhach" class="form-select search-input" aria-label="Số khách">
                    <option value="">Tất cả</option>
                    @for (int guests = 1; guests <= 6; guests++)
                    {
                        <option value="@guests">@guests người</option>
                    }
                </select>
            </div>

            <div class="col-lg-2 col-12 px-lg-3 px-2 py-2">
                <button type="submit" class="btn btn-sawade-primary w-100 rounded-pill py-3">
                    <i class="bi bi-search me-2" aria-hidden="true"></i>Tìm phòng
                </button>
            </div>
        </form>
    </div>
</div>

<div class="container home-content-wrap">
    <!-- 4 GIÁ TRỊ CAM KẾT -->
    <section class="trust-strip row g-3" aria-label="Cam kết dịch vụ">
        <div class="col-6 col-md-3">
            <i class="bi bi-shield-check trust-icon" aria-hidden="true"></i>
            <strong>Đặt phòng an tâm</strong>
            <small>Xác minh chống trùng lịch tức thì</small>
        </div>
        <div class="col-6 col-md-3">
            <i class="bi bi-headset trust-icon" aria-hidden="true"></i>
            <strong>Hỗ trợ tận tâm</strong>
            <small>Lễ tân đồng hành trong suốt kỳ nghỉ</small>
        </div>
        <div class="col-6 col-md-3">
            <i class="bi bi-stars trust-icon" aria-hidden="true"></i>
            <strong>Không gian chỉn chu</strong>
            <small>Thiết kế ấm áp, tiện nghi đầy đủ</small>
        </div>
        <div class="col-6 col-md-3">
            <i class="bi bi-tags trust-icon" aria-hidden="true"></i>
            <strong>Giá minh bạch</strong>
            <small>Niêm yết trực tiếp theo hệ thống</small>
        </div>
    </section>

    <!-- KHU VỰC 1: KHÁM PHÁ THEO HẠNG PHÒNG -->
    <section id="loai-phong" class="mb-5 pb-lg-3">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="section-eyebrow mb-2">Tìm không gian phù hợp</p>
                <h2 class="section-heading mb-0">Khám phá theo hạng phòng</h2>
            </div>
            <a asp-controller="Home" asp-action="DanhSachPhong" class="home-section-link">
                Xem tất cả phòng <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        @if (rooms.Any())
        {
            var roomTypeGroups = rooms
                .GroupBy(p => string.IsNullOrWhiteSpace(p.TenLoaiPhong) ? "Hạng phòng" : p.TenLoaiPhong.Trim())
                .Select(group => new
                {
                    Representative = group.First(),
                    Count = group.Count(),
                    MinPrice = group.Min(x => x.GiaPhong)
                })
                .Take(6)
                .ToList();

            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var item in roomTypeGroups)
                {
                    var typeRoom = item.Representative;
                    var roomNumber = (typeRoom.SoPhong ?? string.Empty).Trim();
                    var storedImage = (typeRoom.HinhAnh ?? string.Empty).Trim();
                    var imagePath = string.IsNullOrWhiteSpace(storedImage)
                        ? Url.Content("~/images/" + roomNumber + ".jpg")
                        : (storedImage.StartsWith("/") ? Url.Content("~" + storedImage) : Url.Content("~/images/" + storedImage));
                    var fallbackIndex = (int)(Math.Abs((long)typeRoom.PhongId) % fallbackImgs.Length);
                    var fallback = fallbackImgs[fallbackIndex];

                    <div class="col">
                        <a class="home-category-card" href="@(Url.Action("DanhSachPhong", "Home", new { loaiPhong = typeRoom.LoaiPhongId }))">
                            <img src="@imagePath" alt="@HienThiPhong.TenLoai(typeRoom.TenLoaiPhong)" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='@fallback';" />
                            <span class="home-category-badge">@item.Count phòng hiện có</span>
                            <div class="home-category-overlay">
                                <h3>@HienThiPhong.TenLoai(typeRoom.TenLoaiPhong)</h3>
                                <div class="home-category-meta">
                                    <span>Từ <span class="home-category-price">@item.MinPrice.ToString("#,##0") đ</span> / đêm</span>
                                    <span>Khám phá <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-4 p-5 text-center border text-muted">
                @(ViewBag.ApiError != null ? "Không tải được hạng phòng do kết nối API gián đoạn." : "Hiện chưa có dữ liệu hạng phòng để hiển thị.")
            </div>
        }
    </section>

    <!-- KHU VỰC 2: NHỮNG CĂN PHÒNG NỔI BẬT -->
    <section id="phong-noi-bat" class="mt-5 mb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="section-eyebrow mb-2">Lựa chọn dành cho bạn</p>
                <h2 class="section-heading mb-1">Những căn phòng nổi bật</h2>
                <p class="text-muted mb-0">Thông tin tình trạng và mức giá được đồng bộ trực tiếp từ hệ thống quản lý.</p>
            </div>
            <a asp-controller="Home" asp-action="DanhSachPhong" class="home-section-link">
                Danh sách đầy đủ <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </div>

        @if (rooms.Any())
        {
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                @foreach (var room in rooms.Take(6))
                {
                    var roomNumber = (room.SoPhong ?? string.Empty).Trim();
                    var storedImage = (room.HinhAnh ?? string.Empty).Trim();
                    var imagePath = string.IsNullOrWhiteSpace(storedImage)
                        ? Url.Content("~/images/" + roomNumber + ".jpg")
                        : (storedImage.StartsWith("/") ? Url.Content("~" + storedImage) : Url.Content("~/images/" + storedImage));
                    var fallbackIndex = (int)(Math.Abs((long)room.PhongId) % fallbackImgs.Length);
                    var fallback = fallbackImgs[fallbackIndex];

                    var statusText = HienThiPhong.TrangThai(room.TrangThai);
                    var isAvailable = HienThiPhong.DangTrong(room.TrangThai);
                    var statusClass = isAvailable ? "available" : statusText == "Đang có khách" ? "occupied" : "unavailable";

                    <div class="col">
                        <article class="room-card d-flex flex-column h-100">
                            <div class="room-image-wrapper">
                                <img src="@imagePath" alt="Phòng @room.SoPhong" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='@fallback';" />
                                <span class="home-room-badge">@HienThiPhong.TenLoai(room.TenLoaiPhong)</span>
                            </div>
                            <div class="card-body p-4 d-flex flex-column flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h3 class="h5 fw-bold mb-0" style="color: var(--sawade-forest-950);">Phòng @room.SoPhong</h3>
                                    <span class="room-status @statusClass">
                                        <i class="bi @(isAvailable ? "bi-check-circle-fill" : "bi-info-circle-fill")" aria-hidden="true"></i>@statusText
                                    </span>
                                </div>

                                <div class="d-flex flex-wrap gap-3 text-muted small mb-3 mt-1">
                                    <span><i class="bi bi-building me-1 text-gold" aria-hidden="true"></i>@HienThiPhong.TenLoai(room.TenLoaiPhong)</span>
                                    @if (room.SoNguoiToiDa.HasValue)
                                    {
                                        <span><i class="bi bi-people me-1 text-gold" aria-hidden="true"></i>Tối đa @room.SoNguoiToiDa khách</span>
                                    }
                                </div>

                                <div class="mt-auto d-flex justify-content-between align-items-end gap-2 border-top pt-3">
                                    <div>
                                        <span class="text-muted small d-block">Giá mỗi đêm</span>
                                        <strong class="room-price">@room.GiaPhong.ToString("#,##0") đ</strong>
                                    </div>
                                    <a asp-controller="Home" asp-action="ChiTietPhong" asp-route-id="@room.PhongId" class="btn btn-sawade-primary rounded-pill px-4">
                                        Chi tiết <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-4 p-5 text-center border shadow-sm">
                <div class="sawade-empty-icon mb-3"><i class="bi bi-house-x" aria-hidden="true"></i></div>
                <h5 class="fw-bold">@(ViewBag.ApiError != null ? "Không tải được dữ liệu phòng" : "Chưa có phòng để hiển thị")</h5>
                <p class="text-muted mb-0">@(ViewBag.ApiError != null ? "Vui lòng kiểm tra kết nối API và thử tải lại trang." : "Dữ liệu phòng chưa có trong hệ thống. Vui lòng quay lại sau.")</p>
            </div>
        }
    </section>

    <!-- KHU VỰC 3: BANNER TRẢI NGHIỆM & DỊCH VỤ -->
    <section class="mb-5 pb-3">
        <div class="home-editorial-banner">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="hero-eyebrow mb-2">SAWADE EXPERIENCE</div>
                    <h2 class="mb-3">Trọn vẹn từng khoảnh khắc lưu trú với tiện ích đi kèm</h2>
                    <p class="mb-0">Từ dịch vụ ẩm thực, giặt ủi đến hỗ trợ nhận trả phòng linh hoạt — mọi yêu cầu đều được lễ tân tiếp nhận và cập nhật minh bạch ngay trên hồ sơ đặt phòng của bạn.</p>
                </div>
                <div class="col-lg-4 d-flex flex-wrap justify-content-lg-end gap-2">
                    <a asp-controller="Home" asp-action="DichVu" class="hero-cta-primary">
                        Xem dịch vụ <i class="bi bi-cup-hot ms-2" aria-hidden="true"></i>
                    </a>
                    <a asp-controller="Home" asp-action="HuongDan" class="hero-cta-secondary">
                        Hướng dẫn đặt
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const checkIn = document.getElementById('homeNgayNhan');
            const checkOut = document.getElementById('homeNgayTra');
            if (!checkIn || !checkOut) return;

            checkIn.addEventListener('change', () => {
                if (checkIn.value) {
                    const date = new Date(`${checkIn.value}T00:00:00`);
                    date.setDate(date.getDate() + 1);
                    const nextDay = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
                    checkOut.min = nextDay;
                    if (checkOut.value && checkOut.value <= checkIn.value) checkOut.value = nextDay;
                }
            });
        })();
    </script>
}
