@model IEnumerable<QuanLyKhachSan.Web.Models.PhongViewModel>
@using System.Linq

@{
    ViewData["Title"] = "Khách sạn Sawade   ";
    ViewData["NavbarOverlay"] = true;
    var rooms = Model?.ToList() ?? new List<QuanLyKhachSan.Web.Models.PhongViewModel>();

    // Cập nhật mảng fallback để giống với các trang khác
    var fallbackImgs = new[]
    {
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1618773928120-22165582f349?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1566665797739-1674de7a421a?auto=format&fit=crop&w=900&q=80",
        "https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=900&q=80"
    };
}

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-0 text-center m-0" role="alert">
        <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@TempData["ThongBao"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
    </div>
}
@if (ViewBag.ApiError != null)
{
    <div class="alert alert-warning text-center rounded-0 mb-0" role="alert">@ViewBag.ApiError</div>
}

<section class="hero-banner" style="background-image: url('https://images.unsplash.com/photo-1542314831-c6a4d27ce66f?q=80&w=2000&auto=format&fit=crop');">
    <div class="container hero-content pt-5">
        <!-- Đã thêm pb-5 mb-5 để đẩy nội dung lên, không bị thanh tìm kiếm đè -->
        <div class="col-lg-8 col-xl-7 pt-5 mt-5 pb-5 mb-5">
            <p class="hero-eyebrow text-uppercase mb-3">Trải nghiệm nghỉ dưỡng đẳng cấp</p>

            <h1 class="hero-title mb-4">Nơi mỗi kỳ nghỉ<br />là một câu chuyện đẹp</h1>

            <p class="hero-description mb-4">Khám phá không gian lưu trú được tuyển chọn kỹ lưỡng, nơi sự tiện nghi và cảm giác thư thái gặp nhau.</p>

            <!-- Nút khám phá đã được giải phóng khỏi thanh tìm kiếm -->
            <a href="#loai-phong" class="text-white text-decoration-none d-inline-flex align-items-center fw-semibold position-relative" style="z-index: 10;">
                <i class="bi bi-play-circle me-2 fs-3" aria-hidden="true"></i>Khám phá không gian nghỉ dưỡng
            </a>
        </div>
    </div>

    <div class="floating-search-bar">
        <form asp-controller="Home" asp-action="DanhSachPhong" method="get" class="row align-items-center g-2">
            <div class="col-lg-3 col-md-12 px-lg-3 px-2 py-2">
                <label class="text-muted small fw-bold mb-1 d-block"><i class="bi bi-buildings me-1" aria-hidden="true"></i>Khu nghỉ dưỡng</label>
                <div class="fw-semibold">Sawade Hotels &amp; Resorts</div>
                <div class="text-muted small">Khám phá danh sách phòng</div>
            </div>
            <div class="col-lg-3 col-md-5 col-6 border-lg-start px-lg-3 px-2 py-2">
                <label class="text-muted small fw-bold mb-1" for="homeNgayNhan"><i class="bi bi-calendar-check me-1" aria-hidden="true"></i>Ngày nhận phòng</label>
                <input id="homeNgayNhan" type="date" name="ngayNhan" min="@(DateTime.Today.ToString("yyyy-MM-dd"))" class="form-control search-input" />
            </div>
            <div class="col-lg-3 col-md-5 col-6 border-lg-start px-lg-3 px-2 py-2">
                <label class="text-muted small fw-bold mb-1" for="homeNgayTra"><i class="bi bi-calendar-x me-1" aria-hidden="true"></i>Ngày trả phòng</label>
                <input id="homeNgayTra" type="date" name="ngayTra" min="@(DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))" class="form-control search-input" />
            </div>
            <div class="col-lg-3 col-md-2 col-12 px-lg-3 px-2 py-2">
                <button type="submit" class="btn btn-sawade w-100 rounded-pill py-3"><i class="bi bi-search me-2" aria-hidden="true"></i>Tìm phòng</button>
            </div>
        </form>
    </div>
</section>

<div class="container" style="margin-top: 105px;">
    <section class="trust-strip row text-center g-3 mb-5 pb-4 border-bottom">
        <div class="col-6 col-md-3"><i class="bi bi-shield-check trust-icon d-block mb-2" aria-hidden="true"></i><strong class="d-block">Đặt phòng an tâm</strong><small class="text-muted">Thông tin rõ ràng</small></div>
        <div class="col-6 col-md-3"><i class="bi bi-headset trust-icon d-block mb-2" aria-hidden="true"></i><strong class="d-block">Hỗ trợ tận tâm</strong><small class="text-muted">Luôn sẵn sàng hỗ trợ</small></div>
        <div class="col-6 col-md-3"><i class="bi bi-stars trust-icon d-block mb-2" aria-hidden="true"></i><strong class="d-block">Không gian chỉn chu</strong><small class="text-muted">Ưu tiên trải nghiệm</small></div>
        <div class="col-6 col-md-3"><i class="bi bi-tags trust-icon d-block mb-2" aria-hidden="true"></i><strong class="d-block">Giá minh bạch</strong><small class="text-muted">Giá phòng theo hệ thống</small></div>
    </section>

    <!-- KHU VỰC 1: KHÁM PHÁ THEO HẠNG PHÒNG -->
    <section id="loai-phong" class="mb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="section-eyebrow mb-2">Tìm không gian phù hợp</p>
                <h2 class="section-heading mb-0">Khám phá theo hạng phòng</h2>
            </div>
            <a asp-controller="Home" asp-action="DanhSachPhong" class="text-decoration-none fw-semibold" style="color: var(--sawade-forest);">Xem tất cả <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
        </div>

        @if (rooms.Any())
        {
            var roomTypes = rooms
            .GroupBy(p => string.IsNullOrWhiteSpace(p.TenLoaiPhong) ? "Hạng phòng" : p.TenLoaiPhong.Trim())
            .Select(group => group.First())
            .Take(6)
            .ToList();

            <div class="horizontal-scroll-wrapper">
                @foreach (var typeRoom in roomTypes)
                {
                    // ĐỒNG BỘ: Ép lấy ảnh nội bộ theo số phòng
                    var roomNumber = (typeRoom.SoPhong ?? string.Empty).Trim();
                    var imagePath = Url.Content("~/images/" + roomNumber + ".jpg");
                    var fallbackIndex = (int)(Math.Abs((long)typeRoom.PhongId) % fallbackImgs.Length);
                    var fallback = fallbackImgs[fallbackIndex];

                    <a class="horizontal-scroll-item text-decoration-none" href="@(Url.Action("DanhSachPhong", "Home", new { loaiPhong = typeRoom.LoaiPhongId }))">
                        <article class="room-card h-100">
                            <div class="room-image-wrapper" style="height: 250px;">
                                <img src="@imagePath" alt="@typeRoom.TenLoaiPhong" loading="lazy" onerror="this.onerror=null;this.src='@fallback';" />
                                <div class="category-overlay">
                                    <h5 class="fw-bold mb-1">@typeRoom.TenLoaiPhong</h5>
                                    <span class="small text-white-50">Xem các phòng thuộc hạng này <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></span>
                                </div>
                            </div>
                        </article>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-4 p-4 text-center text-muted">Hiện chưa có dữ liệu hạng phòng để hiển thị.</div>
        }
    </section>

    <!-- KHU VỰC 2: NHỮNG CĂN PHÒNG NỔI BẬT -->
    <section id="phong-noi-bat" class="mt-5 mb-5">
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
            <div>
                <p class="section-eyebrow mb-2">Lựa chọn dành cho bạn</p>
                <h2 class="section-heading mb-1">Những căn phòng nổi bật</h2>
                <p class="text-muted mb-0">Thông tin và giá được lấy từ hệ thống quản lý phòng.</p>
            </div>
            <a asp-controller="Home" asp-action="DanhSachPhong" class="text-decoration-none fw-semibold" style="color: var(--sawade-forest);">Xem tất cả <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></a>
        </div>

        @if (rooms.Any())
        {
            <div class="horizontal-scroll-wrapper">
                @foreach (var room in rooms.Take(6))
                {
                    // ĐỒNG BỘ: Ép lấy ảnh nội bộ theo số phòng
                    var roomNumber = (room.SoPhong ?? string.Empty).Trim();
                    var imagePath = Url.Content("~/images/" + roomNumber + ".jpg");
                    var fallbackIndex = (int)(Math.Abs((long)room.PhongId) % fallbackImgs.Length);
                    var fallback = fallbackImgs[fallbackIndex];

                    // Xử lý trạng thái chuẩn hóa
                    var rawStatus = (room.TrangThai ?? string.Empty).Trim();
                    var normalizedStatus = rawStatus.ToLowerInvariant();
                    var isAvailable = normalizedStatus is "trong" or "trống" or "available";
                    var isOccupied = normalizedStatus is "dang co khach" or "đang có khách" or "occupied" or "dango";
                    var isBooked = normalizedStatus is "dadat" or "da dat" or "đã đặt" or "booked"; // Thêm dòng này

                    var statusText = normalizedStatus switch
                    {
                        "trong" or "trống" or "available" => "Còn trống",
                        "dang co khach" or "đang có khách" or "occupied" or "dango" => "Đang có khách",
                        "bao tri" or "bảo trì" or "maintenance" => "Đang bảo trì",
                        "dadat" or "da dat" or "đã đặt" or "booked" => "Đã đặt", // Bổ sung "dadat"
                        _ => string.IsNullOrWhiteSpace(rawStatus) ? "Chưa xác định" : rawStatus
                    };

                    // Cập nhật class css để hiển thị màu
                    var statusClass = isAvailable ? "available" : (isOccupied ? "occupied" : (isBooked ? "booked" : "unavailable"));

                    <div class="horizontal-scroll-item">
                        <article class="room-card d-flex flex-column h-100">
                            <div class="room-image-wrapper">
                                <img src="@imagePath" alt="Phòng @room.SoPhong" loading="lazy" onerror="this.onerror=null;this.src='@fallback';" />
                                <span class="position-absolute top-0 end-0 m-3 badge rounded-pill bg-white text-dark px-3 py-2 shadow-sm">@room.TenLoaiPhong</span>
                            </div>
                            <div class="card-body p-4 d-flex flex-column">
                                <h5 class="fw-bold text-dark mb-2">Phòng @room.SoPhong</h5>
                                <div class="d-flex flex-wrap gap-2 mb-3">
                                    <span class="room-status @statusClass"><i class="bi @(isAvailable ? "bi-check-circle-fill" : "bi-info-circle-fill") me-1" aria-hidden="true"></i>@statusText</span>
                                </div>
                                <p class="text-muted small mb-3"><i class="bi bi-building me-2" aria-hidden="true"></i>@room.TenLoaiPhong</p>
                                <div class="mt-auto d-flex justify-content-between align-items-end gap-2 border-top pt-3">
                                    <div>
                                        <span class="text-muted small d-block mb-1">Giá mỗi đêm</span>
                                        <strong class="room-price">@room.GiaPhong.ToString("#,##0") đ</strong>
                                    </div>
                                    <a asp-controller="Home" asp-action="ChiTietPhong" asp-route-id="@room.PhongId" class="btn btn-sawade rounded-pill px-3">Chi tiết</a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white rounded-4 p-5 text-center shadow-sm">
                <i class="bi bi-house-x fs-1 text-secondary" aria-hidden="true"></i>
                <h5 class="fw-bold mt-3">Chưa có phòng để hiển thị</h5>
                <p class="text-muted mb-0">Hãy kiểm tra Web API và dữ liệu phòng trong cơ sở dữ liệu.</p>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script>
        (() => {
            const checkIn = document.getElementById('homeNgayNhan');
            const checkOut = document.getElementById('homeNgayTra');
            if (!checkIn || !checkOut) return;

            checkIn.addEventListener('change', () => {
                if (checkIn.value) {
                    const date = new Date(`${checkIn.value}T00:00:00`);
                    date.setDate(date.getDate() + 1);
                    const nextDay = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
                    checkOut.min = nextDay;
                    if (checkOut.value && checkOut.value <= checkIn.value) checkOut.value = nextDay;
                }
            });
        })();
    </script>
}