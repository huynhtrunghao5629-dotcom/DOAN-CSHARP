@model QuanLyKhachSan.Web.Models.PhongViewModel

@{
    ViewData["Title"] = "Chi tiết phòng " + Model.SoPhong;
    ViewData["NavbarOverlay"] = false;

    var roomNumber = (Model.SoPhong ?? string.Empty).Trim();
    var storedImage = (Model.HinhAnh ?? string.Empty).Trim();
    var localDetailImage = string.IsNullOrWhiteSpace(storedImage)
        ? Url.Content("~/images/" + roomNumber + ".jpg")
        : (storedImage.StartsWith("/") ? Url.Content("~" + storedImage) : Url.Content("~/images/" + storedImage));

    var fallbackImgs = new[]
    {
        Url.Content("~/images/102.jpg"),
        Url.Content("~/images/201.jpg"),
        Url.Content("~/images/208.jpg")
    };
    var fallbackIndex = (int)(Math.Abs((long)Model.PhongId) % fallbackImgs.Length);
    var fallbackImage = fallbackImgs[fallbackIndex];

    var statusText = HienThiPhong.TrangThai(Model.TrangThai);
    var isAvailable = HienThiPhong.DangTrong(Model.TrangThai);
    var statusPillClass = isAvailable
        ? "available"
        : statusText == "Đang có khách" ? "occupied" : "unavailable";

    DateOnly? selectedCheckIn = ViewBag.NgayNhan as DateOnly?;
    DateOnly? selectedCheckOut = ViewBag.NgayTra as DateOnly?;
    int? selectedGuests = ViewBag.SoKhach as int?;
    string initialCheckIn = selectedCheckIn?.ToString("yyyy-MM-dd") ?? "";
    string initialCheckOut = selectedCheckOut?.ToString("yyyy-MM-dd") ?? "";
    var bookedRanges = ViewBag.LichDaDat as List<string> ?? new List<string>();
}

@section Styles {
    <style>
        .detail-shell {
            padding: 40px 0 88px;
        }

        .detail-room-frame {
            position: relative;
            height: min(52vw, 510px);
            min-height: 300px;
            overflow: hidden;
            background: var(--sawade-forest-950);
            border: 1px solid var(--sawade-line-strong);
        }

        .detail-room-frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .detail-photo-tag {
            position: absolute;
            left: 20px;
            bottom: 20px;
            padding: 7px 14px;
            background: rgba(11, 18, 15, 0.78);
            border-left: 2px solid var(--sawade-gold-400);
            color: var(--sawade-ivory-50);
            font-size: 0.70rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .detail-specs-strip {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            border: 1px solid var(--sawade-line-strong);
            border-top: 0;
            background: var(--sawade-ivory-50);
        }

        .detail-spec-item {
            padding: 18px 16px;
            border-right: 1px solid var(--sawade-line);
        }

        .detail-spec-item:last-child {
            border-right: 0;
        }

        .detail-spec-label {
            display: block;
            font-size: 0.65rem;
            letter-spacing: 0.16em;
            text-transform: uppercase;
            color: var(--sawade-muted);
            margin-bottom: 4px;
        }

        .detail-spec-val {
            font-weight: 600;
            font-size: 0.88rem;
            color: var(--sawade-forest-950);
        }

        .detail-overview-card {
            padding: 32px;
            border: 1px solid var(--sawade-line-strong);
            background: var(--sawade-ivory-50);
        }

        .detail-perk-row {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 12px 24px;
            padding-top: 20px;
            border-top: 1px solid var(--sawade-line);
        }

        .detail-perk-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 0.86rem;
            color: var(--sawade-ink-soft);
        }

        .detail-perk-item i {
            color: var(--sawade-gold-600);
        }

        .detail-sticky-col {
            position: sticky;
            top: 100px;
        }

        .detail-estimate-box {
            padding: 18px;
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line);
        }

        .detail-estimate-total {
            font-family: var(--sawade-font-display);
            color: var(--sawade-forest-950);
            font-size: 1.65rem;
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .booked-dates-box {
            padding: 14px 16px;
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line-strong);
            border-left: 3px solid var(--sawade-gold-500);
        }

        .booked-date-tag {
            display: inline-block;
            padding: 4px 10px;
            background: #fff;
            border: 1px solid var(--sawade-line-strong);
            font-size: 0.76rem;
            font-variant-numeric: tabular-nums;
            color: var(--sawade-forest-950);
        }

        @@media (max-width: 991.98px) {
            .detail-sticky-col {
                position: static;
            }
        }

        @@media (max-width: 575.98px) {
            .detail-specs-strip {
                grid-template-columns: 1fr;
            }
            .detail-spec-item {
                border-right: 0;
                border-bottom: 1px solid var(--sawade-line);
            }
            .detail-spec-item:last-child {
                border-bottom: 0;
            }
            .detail-perk-row {
                grid-template-columns: 1fr;
            }
            .detail-overview-card {
                padding: 22px;
            }
        }
    </style>
}

<div class="container detail-shell">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0 small" style="letter-spacing: 0.04em;">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="DanhSachPhong" class="text-decoration-none">Phòng nghỉ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Phòng @Model.SoPhong</li>
        </ol>
    </nav>

    <div class="row g-4 g-xl-5 align-items-start">
        <!-- CỘT TRÁI: HÌNH ẢNH & THÔNG TIN PHÒNG -->
        <div class="col-lg-7">
            <div class="detail-room-frame">
                <img src="@localDetailImage"
                     alt="Không gian phòng @Model.SoPhong"
                     onerror="this.onerror=null;this.src='@fallbackImage';" />
                <div class="detail-photo-tag">PHÒNG @Model.SoPhong &middot; @HienThiPhong.TenLoai(Model.TenLoaiPhong)</div>
            </div>

            <div class="detail-specs-strip mb-4">
                <div class="detail-spec-item">
                    <span class="detail-spec-label">Hạng phòng</span>
                    <span class="detail-spec-val">@HienThiPhong.TenLoai(Model.TenLoaiPhong)</span>
                </div>
                <div class="detail-spec-item">
                    <span class="detail-spec-label">Sức chứa tiêu chuẩn</span>
                    <span class="detail-spec-val">@(Model.SoNguoiToiDa.HasValue ? $"Tối đa {Model.SoNguoiToiDa} người" : "Tiêu chuẩn khách sạn")</span>
                </div>
                <div class="detail-spec-item">
                    <span class="detail-spec-label">Hiện trạng phòng</span>
                    <span class="detail-spec-val">@statusText</span>
                </div>
            </div>

            <div class="detail-overview-card">
                <div class="section-eyebrow mb-2">OVERVIEW &amp; PRIVILEGES</div>
                <h2 class="editorial-serif h3 mb-3">Tổng quan không gian lưu trú</h2>
                <p class="luxe-lead mb-4">
                    @(string.IsNullOrWhiteSpace(Model.MoTaLoaiPhong)
                        ? "Không gian lưu trú được thiết kế ấm áp, chú trọng ánh sáng tự nhiên và sự riêng tư. Thông tin tình trạng phòng cùng biểu giá được đồng bộ trực tiếp từ hệ thống quản lý khách sạn."
                        : Model.MoTaLoaiPhong)
                </p>

                <div class="detail-perk-row">
                    <div class="detail-perk-item"><i class="bi bi-check2" aria-hidden="true"></i><span>Biểu giá niêm yết minh bạch</span></div>
                    <div class="detail-perk-item"><i class="bi bi-check2" aria-hidden="true"></i><span>Xác minh lịch trống theo ngày</span></div>
                    <div class="detail-perk-item"><i class="bi bi-check2" aria-hidden="true"></i><span>Cấp mã đơn ngay sau khi gửi</span></div>
                    <div class="detail-perk-item"><i class="bi bi-check2" aria-hidden="true"></i><span>In phiếu xác nhận &amp; tra cứu 24/7</span></div>
                </div>

                <div class="mt-4 pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <span class="small text-muted">Cần thêm ẩm thực, giặt ủi trong thời gian lưu trú?</span>
                    <a asp-controller="Home" asp-action="DichVu" class="small fw-semibold text-decoration-none" style="letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.72rem;">
                        Xem danh mục dịch vụ <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: GIÁ & BIỂU MẪU ĐẶT PHÒNG -->
        <div class="col-lg-5 detail-sticky-col">
            <div class="booking-panel">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <span class="detail-type-badge">@HienThiPhong.TenLoai(Model.TenLoaiPhong)</span>
                    <span class="room-status @statusPillClass">@statusText</span>
                </div>

                <h1 class="detail-page-title mb-2">Phòng @Model.SoPhong</h1>

                <div class="detail-price mb-4 pb-3 border-bottom d-flex align-items-baseline gap-2">
                    <span>@Model.GiaPhong.ToString("#,##0") đ</span>
                    <small class="text-muted">/ đêm</small>
                </div>

                @if (selectedGuests.HasValue && Model.SoNguoiToiDa.HasValue && selectedGuests.Value > Model.SoNguoiToiDa.Value)
                {
                    <div class="alert alert-warning small mb-3" role="alert">
                        <i class="bi bi-exclamation-triangle me-2" aria-hidden="true"></i>
                        Phòng này không đủ sức chứa cho @selectedGuests người. Vui lòng chọn hạng phòng phù hợp hơn.
                    </div>
                }

                <div class="mb-3">
                    <div class="luxe-kicker mb-1">RESERVATION FOLIO</div>
                    <p class="text-muted small mb-0">Chọn ngày lưu trú để hệ thống kiểm tra lịch trống và gửi yêu cầu tới lễ tân.</p>
                </div>

                <form asp-controller="Home" asp-action="DatPhong" method="post" class="row g-3" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PhongId" value="@Model.PhongId" />

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="col-12">
                            <div class="p-3 small" style="background: var(--sawade-ivory-100); border: 1px solid var(--sawade-line);">
                                Đặt bằng tài khoản <strong>@User.Identity.Name</strong>
                                (@User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value).
                                <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="fw-semibold ms-1">Hồ sơ</a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="col-12">
                            <div class="alert alert-warning small mb-0">
                                <i class="bi bi-lock me-1" aria-hidden="true"></i>
                                Bạn cần <a asp-controller="TaiKhoan" asp-action="DangNhap" class="fw-semibold">đăng nhập</a>
                                hoặc <a asp-controller="TaiKhoan" asp-action="DangKy" class="fw-semibold">đăng ký</a> để gửi yêu cầu đặt phòng.
                            </div>
                        </div>
                    }

                    @if (bookedRanges.Any())
                    {
                        <div class="col-12">
                            <div class="booked-dates-box small">
                                <div class="fw-semibold mb-2" style="color: var(--sawade-forest-950);">
                                    <i class="bi bi-calendar-x me-1 text-gold" aria-hidden="true"></i>Các khoảng ngày đã có lịch đặt trước:
                                </div>
                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    @foreach (var range in bookedRanges)
                                    {
                                        <span class="booked-date-tag">@range</span>
                                    }
                                </div>
                                <div class="text-muted" style="font-size: 0.75rem;">
                                    Bạn vẫn đặt phòng này bình thường cho các khoảng ngày khác không trùng lịch trên.
                                </div>
                            </div>
                        </div>
                    }

                    <div class="col-md-6">
                        <label class="form-label" for="bookingCheckIn">Ngày nhận phòng</label>
                        <input id="bookingCheckIn" type="date" class="form-control" name="NgayNhan" value="@initialCheckIn" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="bookingCheckOut">Ngày trả phòng</label>
                        <input id="bookingCheckOut" type="date" class="form-control" name="NgayTra" value="@initialCheckOut" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                    </div>

                    <div class="col-12">
                        <label for="bookingGuests" class="form-label">Số khách lưu trú</label>
                        <select id="bookingGuests" name="SoKhach" class="form-select" required>
                            @for (int guests = 1; guests <= (Model.SoNguoiToiDa.HasValue ? Math.Min(Model.SoNguoiToiDa.Value, 30) : 10); guests++)
                            {
                                <option value="@guests" selected="@(selectedGuests == guests || (!selectedGuests.HasValue && guests == 1))">@guests người</option>
                            }
                        </select>
                        <small class="text-muted d-block mt-1" style="font-size: 0.76rem;">Số khách được kiểm tra theo sức chứa tiêu chuẩn của hạng phòng.</small>
                    </div>

                    <div class="col-12">
                        <div class="detail-estimate-box">
                            <div class="luxe-kicker mb-2">TẠM TÍNH CHI PHÍ</div>
                            <div class="d-flex justify-content-between small">
                                <span class="text-muted">Đơn giá mỗi đêm</span>
                                <strong class="tabular-nums">@Model.GiaPhong.ToString("N0") đ</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center small mt-2 pt-2 border-top">
                                <span class="text-muted">Số đêm dự kiến</span>
                                <strong id="bookingNights">—</strong>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top">
                                <span class="fw-semibold small text-uppercase" style="letter-spacing: 0.08em;">Tổng tạm tính</span>
                                <strong id="bookingEstimate" class="detail-estimate-total">—</strong>
                            </div>
                            <div class="small text-muted mt-2" style="font-size: 0.74rem;">
                                Chưa bao gồm dịch vụ phát sinh trong thời gian lưu trú.
                            </div>
                        </div>
                    </div>

                    <div class="col-12 pt-1">
                        <button type="submit" class="btn btn-sawade-primary btn-lg w-100" disabled="@(User.Identity?.IsAuthenticated != true)">
                            Gửi yêu cầu đặt phòng <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                        </button>
                        <p class="small text-muted text-center mt-3 mb-0" style="font-size: 0.76rem;">
                            Yêu cầu sẽ được lễ tân xác nhận trực tiếp trên hệ thống.
                        </p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const checkIn = document.getElementById('bookingCheckIn');
            const checkOut = document.getElementById('bookingCheckOut');
            if (!checkIn || !checkOut) return;

            const nightlyPrice = @Model.GiaPhong.ToString(System.Globalization.CultureInfo.InvariantCulture);
            const nightsEl = document.getElementById('bookingNights');
            const estimateEl = document.getElementById('bookingEstimate');

            const updateEstimate = () => {
                if (!checkIn.value || !checkOut.value) {
                    nightsEl.textContent = '—';
                    estimateEl.textContent = '—';
                    return;
                }
                const start = new Date(`${checkIn.value}T00:00:00`);
                const end = new Date(`${checkOut.value}T00:00:00`);
                const nights = Math.round((end.getTime() - start.getTime()) / (24 * 60 * 60 * 1000));
                if (!Number.isFinite(nights) || nights <= 0) {
                    nightsEl.textContent = 'Chưa hợp lệ';
                    estimateEl.textContent = '—';
                    return;
                }
                nightsEl.textContent = `${nights} đêm`;
                estimateEl.textContent = (nights * nightlyPrice).toLocaleString('vi-VN') + ' đ';
            };

            const formatDateYmd = (date) =>
                `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;

            checkIn.min = formatDateYmd(new Date());

            checkIn.addEventListener('change', () => {
                if (!checkIn.value) return;
                const date = new Date(`${checkIn.value}T00:00:00`);
                date.setDate(date.getDate() + 1);
                const minCheckOut = formatDateYmd(date);
                checkOut.min = minCheckOut;

                if (checkOut.value && checkOut.value <= checkIn.value) {
                    checkOut.value = minCheckOut;
                }
                updateEstimate();
            });
            checkOut.addEventListener('change', updateEstimate);

            const bookingForm = document.getElementById('bookingForm');
            const submitButton = bookingForm?.querySelector('button[type="submit"]');
            if (bookingForm && submitButton) {
                const originallyDisabled = submitButton.disabled;
                const buttonText = submitButton.innerHTML;
                let sending = false;
                bookingForm.addEventListener('submit', event => {
                    if (!bookingForm.checkValidity()) return;
                    if (sending) {
                        event.preventDefault();
                        return;
                    }
                    sending = true;
                    submitButton.disabled = true;
                    submitButton.textContent = 'Đang gửi yêu cầu đặt phòng...';
                });
                window.addEventListener('pageshow', () => {
                    sending = false;
                    submitButton.disabled = originallyDisabled;
                    submitButton.innerHTML = buttonText;
                });
            }
            updateEstimate();
        })();
    </script>
}
