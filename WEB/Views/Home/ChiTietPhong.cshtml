@model QuanLyKhachSan.Web.Models.PhongViewModel

@{
    ViewData["Title"] = "Chi tiết phòng " + Model.SoPhong;
    ViewData["NavbarOverlay"] = false;

    // CHỈ LẤY ẢNH TỪ WWWROOT/IMAGES CHO CHI TIẾT
    var roomNumber = (Model.SoPhong ?? string.Empty).Trim();
    var localDetailImage = Url.Content("~/images/" + roomNumber + ".jpg");

    var fallbackImgs = new[]
    {
        "https://images.unsplash.com/photo-1590490360182-c33d57733427?q=80&w=1100&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1618773928120-22165582f349?q=80&w=1100&auto=format&fit=crop",
        "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?q=80&w=1100&auto=format&fit=crop"
    };
    var fallbackIndex = (int)(Math.Abs((long)Model.PhongId) % fallbackImgs.Length);
    var fallbackImage = fallbackImgs[fallbackIndex];

    // XỬ LÝ CHUẨN HÓA TRẠNG THÁI TIẾNG VIỆT
    var rawStatus = (Model.TrangThai ?? string.Empty).Trim();
    var normalizedStatus = rawStatus.ToLowerInvariant();

    var isAvailable = normalizedStatus is "trong" or "trống" or "available";
    var isOccupied = normalizedStatus is "dang co khach" or "đang có khách" or "occupied" or "dango";
    var isBooked = normalizedStatus is "dadat" or "da dat" or "đã đặt" or "booked";

    var statusText = normalizedStatus switch
    {
        "trong" or "trống" or "available" => "Còn trống",
        "dang co khach" or "đang có khách" or "occupied" or "dango" => "Đang có khách",
        "bao tri" or "bảo trì" or "maintenance" => "Đang bảo trì",
        "dadat" or "da dat" or "đã đặt" or "booked" => "Đã đặt", // <-- Đã thêm "dadat" viết liền
        _ => string.IsNullOrWhiteSpace(rawStatus) ? "Chưa xác định" : rawStatus
    };

    // Thêm màu text-warning cho trạng thái Đã đặt
    var statusClass = isAvailable ? "text-success" : (isOccupied ? "text-danger" : (isBooked ? "text-warning" : "text-secondary"));
}
<div class="container py-4 py-lg-5">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="DanhSachPhong" class="text-decoration-none text-dark">Danh sách phòng</a></li>
            <li class="breadcrumb-item active" aria-current="page">Phòng @Model.SoPhong</li>
        </ol>
    </nav>

    <div class="row g-4 g-xl-5 bg-white p-3 p-md-4 p-lg-5 rounded-4 shadow-sm align-items-start">
        <div class="col-lg-7">
            <div class="detail-room-image shadow-sm">
                <img src="@localDetailImage"
                     alt="Không gian phòng @Model.SoPhong"
                     class="w-100 h-100 object-fit-cover"
                     onerror="this.onerror=null;this.src='@fallbackImage';" />
            </div>
            <div class="row g-3 mt-1">
                <div class="col-4"><div class="detail-feature"><i class="bi bi-shield-check" aria-hidden="true"></i><span>Đặt phòng an tâm</span></div></div>
                <div class="col-4"><div class="detail-feature"><i class="bi bi-stars" aria-hidden="true"></i><span>Không gian chỉn chu</span></div></div>
                <div class="col-4"><div class="detail-feature"><i class="bi bi-headset" aria-hidden="true"></i><span>Hỗ trợ tận tâm</span></div></div>
            </div>
        </div>

        <div class="col-lg-5">
            <span class="detail-type-badge"><i class="bi bi-door-open me-1" aria-hidden="true"></i>@(string.IsNullOrWhiteSpace(Model.TenLoaiPhong) ? "Hạng phòng" : Model.TenLoaiPhong)</span>
            <h1 class="display-6 fw-bold mt-3 mb-2">Phòng @Model.SoPhong</h1>
            <p class="text-muted mb-3">Không gian nghỉ dưỡng riêng tư, được thiết kế để bạn tận hưởng một kỳ nghỉ thật thư thái.</p>

            <div class="detail-price mb-3">
                <span>@Model.GiaPhong.ToString("#,##0") đ</span>
                <small>/ đêm</small>
            </div>

            <div class="mb-4">
                <span class="text-muted me-2"><i class="bi bi-circle-fill me-1" style="font-size: .55rem;" aria-hidden="true"></i>Trạng thái:</span>
                <strong class="@statusClass">@statusText</strong>
            </div>

            @if (TempData["Loi"] != null)
            {
                <div class="alert alert-danger rounded-3" role="alert">@TempData["Loi"]</div>
            }

            <div class="booking-panel">
                <h2 class="h5 fw-bold mb-1">Gửi yêu cầu đặt phòng</h2>
                <p class="text-muted small mb-4">Vui lòng điền thông tin khách hàng và ngày lưu trú.</p>

                <form asp-controller="Home" asp-action="DatPhong" method="post" class="row g-3" id="bookingForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="PhongId" value="@Model.PhongId" />

                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="bookingName">Họ và tên</label>
                        <input id="bookingName" type="text" class="form-control rounded-3 py-2" name="HoTen" autocomplete="name" maxlength="120" placeholder="Nhập họ tên khách hàng" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="bookingPhone">Số điện thoại</label>
                        <input id="bookingPhone" type="tel" class="form-control rounded-3 py-2" name="SoDienThoai" autocomplete="tel" inputmode="numeric" pattern="[0-9]{10,11}" maxlength="11" placeholder="10–11 chữ số" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="bookingCccd">CCCD / CMND</label>
                        <input id="bookingCccd" type="text" class="form-control rounded-3 py-2" name="CCCD" inputmode="numeric" maxlength="20" placeholder="Số giấy tờ" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="bookingCheckIn">Thời gian nhận phòng</label>
                        <!-- Đã đổi thành datetime-local -->
                        <input id="bookingCheckIn" type="datetime-local" class="form-control rounded-3 py-2" name="NgayNhan" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="bookingCheckOut">Thời gian trả phòng</label>
                        <input id="bookingCheckOut" type="datetime-local" class="form-control rounded-3 py-2" name="NgayTra" required />
                    </div>
                    <div class="col-12 pt-2">
                        <button type="submit" class="btn btn-dark btn-lg w-100 rounded-pill py-3">Gửi yêu cầu đặt phòng <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i></button>
                        <p class="small text-muted text-center mt-3 mb-0">Yêu cầu chỉ được xác nhận khi hệ thống xử lý thành công.</p>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .detail-room-image {
        height: min(58vw, 510px);
        min-height: 300px;
        overflow: hidden;
        border-radius: 18px;
        background: #e9e8e1;
    }

    .detail-feature {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 7px;
        height: 90px;
        padding: 8px 4px;
        text-align: center;
        border: 1px solid #efeee8;
        border-radius: 12px;
        color: #566258;
        font-size: .75rem;
    }

        .detail-feature i {
            color: #987447;
            font-size: 1.2rem;
        }

    .detail-type-badge {
        display: inline-block;
        border-radius: 999px;
        padding: 7px 13px;
        background: #f4ecdc;
        color: #74582e;
        font-size: .82rem;
        font-weight: 700;
    }

    .detail-price {
        display: flex;
        align-items: baseline;
        gap: 7px;
        color: #987447;
    }

        .detail-price span {
            font-size: 1.8rem;
            font-weight: 800;
        }

        .detail-price small {
            color: #7a807a;
        }

    .booking-panel {
        border: 1px solid #eceae5;
        border-radius: 18px;
        padding: 22px;
        background: #fbfaf7;
    }

    @@media (max-width: 575.98px) {
        .detail-room-image {
            min-height: 260px;
            height: 70vw;
        }

        .booking-panel {
            padding: 17px;
        }
    }

    /* Ghi đè màu nút btn-dark cho đồng bộ */
    .btn-dark {
        background-color: #24392f;
        border-color: #24392f;
    }

        .btn-dark:hover {
            background-color: #3c5546;
            border-color: #3c5546;
        }
</style>

@section Scripts {
    <script>
        (() => {
            const checkIn = document.getElementById('bookingCheckIn');
            const checkOut = document.getElementById('bookingCheckOut');
            if (!checkIn || !checkOut) return;

            // Hàm lấy thời gian hiện tại chuẩn định dạng datetime-local (YYYY-MM-DDTHH:mm)
            const getLocalIsoString = (date) => {
                const tzOffset = date.getTimezoneOffset() * 60000;
                return (new Date(date - tzOffset)).toISOString().slice(0, 16);
            };

            // Ép người dùng không được chọn thời gian trong quá khứ
            const now = new Date();
            checkIn.min = getLocalIsoString(now);

            checkIn.addEventListener('change', () => {
                if (!checkIn.value) return;
                const date = new Date(checkIn.value);
                date.setHours(date.getHours() + 2); // Trả phòng ít nhất phải sau 2 tiếng

                const minCheckOut = getLocalIsoString(date);
                checkOut.min = minCheckOut;

                if (checkOut.value && checkOut.value <= checkIn.value) {
                    checkOut.value = minCheckOut;
                }
            });
        })();
    </script>
}