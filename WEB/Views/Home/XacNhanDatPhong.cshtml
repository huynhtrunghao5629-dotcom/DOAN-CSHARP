@{
    ViewData["Title"] = "Xác nhận đặt phòng";
    ViewData["NavbarOverlay"] = false;
}
<div class="container py-5 my-5">
  <div class="card border-0 shadow-sm rounded-4 mx-auto p-4 p-md-5 text-center" style="max-width:680px">
    <div class="text-success display-3 mb-3"><i class="bi bi-check-circle-fill"></i></div>
    <h1 class="h3 fw-bold">Đặt phòng thành công!</h1>
    <p class="text-muted mb-3">Yêu cầu đặt phòng đã được hệ thống ghi nhận.</p>
    <div class="bg-light rounded-3 p-3 mb-4"><span class="text-muted">Mã đơn đặt phòng</span><div class="h4 fw-bold mb-0">@ViewBag.MaDon</div></div>
    <p class="small text-muted">Hãy lưu mã đơn để đối chiếu khi liên hệ khách sạn. Trạng thái và chi tiết đơn phụ thuộc dữ liệu từ hệ thống.</p>
    <div class="d-flex gap-2 justify-content-center flex-wrap">
       <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-outline-dark">Xem phòng khác</a>
       <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="btn btn-success">Lịch sử đặt phòng</a>
    </div>
  </div>
</div>
