@{
    ViewData["Title"] = "Xác nhận đặt phòng";
    ViewData["NavbarOverlay"] = false;
}

<section class="luxe-page">
    <div class="container">
        <div class="confirm-card text-center">
            <div class="confirm-icon"><i class="bi bi-check2"></i></div>
            <div class="luxe-kicker mb-2">REQUEST RECEIVED</div>
            <h1 class="luxe-title h2 fw-bold mb-3">Yêu cầu đặt phòng đã được ghi nhận</h1>
            <p class="luxe-lead mb-4">Lễ tân sẽ xử lý yêu cầu của bạn trên hệ thống. Bạn có thể theo dõi trạng thái mới nhất trong lịch sử đặt phòng.</p>

            <div class="confirm-code mb-4">
                <span class="small text-muted d-block mb-1">Mã đơn đặt phòng</span>
                <div class="h3 fw-bold mb-2">@ViewBag.MaDon</div>
                <span class="badge rounded-pill text-bg-light border px-3 py-2">Trạng thái: @ViewBag.TrangThai</span>
            </div>

            <p class="small text-muted mb-4">Hãy lưu mã đơn để đối chiếu khi cần. Trạng thái đơn có thể thay đổi sau khi lễ tân xác nhận.</p>

            <div class="d-flex gap-2 justify-content-center flex-wrap">
                <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-outline-dark rounded-pill px-4">Xem phòng khác</a>
                <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="btn btn-sawade-primary rounded-pill px-4">Lịch sử đặt phòng</a>
                <a asp-controller="DonDatPhong" asp-action="ChiTiet" asp-route-id="@ViewBag.DatPhongId" class="btn btn-outline-success rounded-pill px-4"><i class="bi bi-file-earmark-text me-1"></i>Chi tiết đơn</a>
            </div>
        </div>
    </div>
</section>
