@model List<QuanLyKhachSan.Web.Models.LichSuDatPhongViewModel>
@{
    ViewData["Title"] = "Tra cứu lịch sử đặt phòng";
    ViewData["NavbarOverlay"] = false;
    string sdt = ViewBag.SoDienThoai as string ?? "";
    var donHangs = Model ?? new List<QuanLyKhachSan.Web.Models.LichSuDatPhongViewModel>();
}

<style>
.luxe-lookup{max-width:1050px}.luxe-lookup .lookup-kicker{letter-spacing:.18em;font-size:.75rem;font-weight:700;color:#866438}.luxe-lookup h1{font-size:clamp(2rem,4vw,3rem);font-weight:500!important}.luxe-lookup .card{border:1px solid #e5dfd3!important;box-shadow:0 12px 35px #19342b0b!important}.luxe-lookup .card-header{background:#fdfbf6!important}.luxe-lookup .lookup-accent{color:#866438}.luxe-lookup .lookup-date{color:#19342b}.luxe-lookup .badge{padding:8px 12px;border-radius:20px}.luxe-lookup .btn-dark{background:#19342b!important}.luxe-lookup .input-group{border-color:#dcd4c5!important}.luxe-lookup .card-body img{height:150px!important}.luxe-lookup .card-footer{padding:16px 24px!important}
@@media(max-width:575.98px){.luxe-lookup .input-group{border-radius:14px!important}.luxe-lookup .card-body img{height:190px!important}.luxe-lookup .card-body,.luxe-lookup .card-header{padding:16px!important}.luxe-lookup .input-group .btn{padding-inline:12px!important}}
</style>
<div class="container luxe-lookup py-5 mb-5">
    <div class="row justify-content-center mb-5">
        <div class="col-md-8 col-lg-6 text-center">
            <p class="lookup-kicker">SAWADE · KỲ NGHỈ CỦA BẠN</p>
            <h1 class="fw-bold mb-3" style="color: #24392f; font-family: Georgia, serif;">Tra cứu đặt phòng</h1>
            <p class="text-muted">Xem mã đơn, thời gian lưu trú và trạng thái những đơn đặt phòng thuộc tài khoản của bạn.</p>

            <form asp-controller="TraCuuDon" asp-action="Index" method="post" class="mt-4" data-sawade-busy="Đang tải đơn...">
                @Html.AntiForgeryToken()
                <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden border">
                    <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-telephone text-muted"></i></span>
                    <input type="tel" name="soDienThoai" value="@sdt" class="form-control border-0 px-3 bg-light" readonly aria-label="Số điện thoại tài khoản">
                    <button class="btn btn-dark px-4 fw-bold" type="submit" style="background-color: #24392f;">
                        Làm mới
                    </button>
                </div>
            </form>

        </div>
    </div>

    <!-- KHU VỰC HIỂN THỊ KẾT QUẢ TỪ DATABASE -->
    @if (!string.IsNullOrEmpty(sdt) && donHangs.Any())
    {
        <h5 class="fw-bold mb-4">Đang có <span class="lookup-accent">@donHangs.Count</span> đơn đặt phòng của tài khoản: <span class="lookup-accent">@sdt</span></h5>
        <div class="row g-4">
            @foreach (var don in donHangs)
            {
                var badgeClass = TrangThaiDatPhong.MauBadge(don.TrangThai);
                var statusText = TrangThaiDatPhong.HienThi(don.TrangThai);

                <div class="col-12">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <div>
                                <span class="badge @badgeClass mb-1">@statusText</span>
                                <h6 class="mb-0 fw-bold">Mã đơn: @don.MaDon</h6>
                            </div>
                            <div class="text-end">
                                <small class="text-muted d-block">Ngày tạo: @(don.NgayDat?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật")</small>
                                <strong class="lookup-accent fs-5">@don.TongTien.ToString("#,##0") đ</strong>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <div class="row align-items-center">
                                @if (don.Phong != null)
                                {
                                    var imgPath = Url.Content($"~/images/{don.Phong.SoPhong.Trim()}.jpg");
                                    <div class="col-md-3 mb-3 mb-md-0">
                                        <img src="@imgPath" class="w-100 rounded-3 object-fit-cover" style="height: 120px;" alt="Phòng @don.Phong.SoPhong" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='@Url.Content("~/images/room-placeholder.svg")';">
                                    </div>
                                    <div class="col-md-9">
                                        <h5 class="fw-bold mb-2">@HienThiPhong.TenLoai(don.Phong.TenLoaiPhong) (@don.Phong.SoPhong)</h5>
                                        <div class="row g-3">
                                            <div class="col-sm-6">
                                                <p class="mb-1 small text-muted"><i class="bi bi-box-arrow-in-right me-1"></i> Nhận phòng:</p>
                                                <!-- Đã lấy GIỜ THẬT từ Database (định dạng: Ngày/Tháng/Năm - Giờ:Phút) -->
                                                <strong class="d-block lookup-date">@(don.NgayNhan?.ToString("dd/MM/yyyy - HH:mm") ?? "Chưa cập nhật")</strong>
                                            </div>
                                            <div class="col-sm-6">
                                                <p class="mb-1 small text-muted"><i class="bi bi-box-arrow-right me-1"></i> Trả phòng:</p>
                                                <!-- Đã lấy GIỜ THẬT từ Database -->
                                                <strong class="d-block lookup-date">@(don.NgayTra?.ToString("dd/MM/yyyy - HH:mm") ?? "Chưa cập nhật")</strong>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-12 text-muted fst-italic">Đơn hàng không có chi tiết phòng.</div>
                                }
                            </div>
                        </div>
                        <div class="card-footer bg-white border-top p-3 text-end">
                            <a asp-controller="DonDatPhong" asp-action="ChiTiet" asp-route-id="@don.DatPhongId" class="btn btn-outline-dark btn-sm rounded-pill px-4"><i class="bi bi-file-earmark-text me-1" aria-hidden="true"></i>Xem chi tiết đơn</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (ViewBag.LoiTaiLichSu != true)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-calendar2-x fs-1 text-muted" aria-hidden="true"></i>
            <h3 class="h5 mt-3">Chưa có đơn đặt phòng</h3>
            <p class="text-muted">Bạn có thể tìm phòng và gửi yêu cầu đặt phòng ngay trên website.</p>
            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade rounded-pill px-4 mx-auto">Tìm phòng</a>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center" role="alert">
            <i class="bi bi-wifi-off fs-1 text-muted" aria-hidden="true"></i>
            <h3 class="h5 mt-3">Chưa thể tải lịch sử đặt phòng</h3>
            <p class="text-muted">Không kết nối được với hệ thống. Vui lòng thử lại sau.</p>
            <a asp-controller="TraCuuDon" asp-action="Index" class="btn btn-sawade rounded-pill px-4 mx-auto">Thử tải lại</a>
        </div>
    }
</div>
