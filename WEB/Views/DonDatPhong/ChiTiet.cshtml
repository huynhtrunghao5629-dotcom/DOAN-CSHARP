@model QuanLyKhachSan.Web.Models.ChiTietDonViewModel
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.MaDon;
    ViewData["NavbarOverlay"] = false;
    var nights = Model.NgayNhan.HasValue && Model.NgayTra.HasValue
        ? (int?)Math.Max(1, Math.Ceiling((Model.NgayTra.Value - Model.NgayNhan.Value).TotalDays))
        : null;
    var canCancel = TrangThaiDatPhong.ChoPhepHuy(Model.TrangThai);
}

@section Styles {
    <style>
        .booking-detail-page {
            min-height: 74vh;
        }

        .booking-detail-head {
            color: #fff;
        }

        .booking-detail-head .badge {
            padding: 8px 14px;
            border-radius: 999px;
            font-size: 0.78rem;
            font-weight: 600;
        }

        .booking-detail-body {
            overflow-wrap: anywhere;
        }

        .booking-detail-note {
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line) !important;
            color: var(--sawade-ink-soft);
        }

        .booking-detail-section-title {
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--sawade-forest-950);
            margin-bottom: 14px;
        }

        .booking-detail-section-title i {
            color: var(--sawade-gold-500);
            font-size: 1.05rem;
        }

        .booking-detail-body .table {
            margin-bottom: 0;
            border-color: var(--sawade-line);
        }

        .booking-detail-body .table-light {
            --bs-table-bg: var(--sawade-ivory-100);
            --bs-table-color: var(--sawade-forest-950);
        }

        .booking-detail-total-bar {
            padding: 18px 22px;
            border-radius: 16px;
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line);
        }

        .booking-detail-actions {
            max-width: 840px;
            margin: 20px auto 0;
        }

        @@media (max-width: 575.98px) {
            .booking-detail-actions > div,
            .booking-detail-actions form {
                width: 100%;
            }
            .booking-detail-actions .btn {
                flex: 1;
            }
            .booking-detail-actions form .btn {
                width: 100%;
            }
        }

        @@media print {
            @@page {
                size: A4;
                margin: 13mm;
            }
            .navbar,
            .site-footer,
            .booking-detail-actions,
            .booking-detail-note,
            .booking-detail-page .breadcrumb,
            .sawade-back-to-top {
                display: none !important;
            }
            body,
            .booking-detail-page {
                background: #fff !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .booking-detail-sheet {
                max-width: none !important;
                border: 0 !important;
                border-radius: 0 !important;
                box-shadow: none !important;
            }
            .booking-detail-head {
                background: #fff !important;
                color: #153127 !important;
                border-bottom: 2px solid #153127;
                padding: 10px 0 18px !important;
            }
            .booking-detail-head h1 {
                color: #153127 !important;
            }
            .booking-detail-body {
                padding: 20px 0 !important;
            }
            .booking-detail-box {
                break-inside: avoid;
            }
            .badge {
                border: 1px solid #666;
                color: #111 !important;
                background: #fff !important;
            }
        }
    </style>
}

<div class="booking-detail-page">
    <div class="container">
        <nav class="breadcrumb small mb-4" aria-label="Đường dẫn">
            <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="text-decoration-none">Tài khoản của tôi</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-muted">Chi tiết đơn đặt phòng</span>
        </nav>

        <article class="booking-detail-sheet">
            <header class="booking-detail-head d-flex flex-wrap justify-content-between gap-3 align-items-start">
                <div>
                    <div class="small text-uppercase fw-semibold mb-2" style="color: var(--sawade-gold-300); letter-spacing: 0.2em; font-size: 0.72rem;">
                        SAWADE HOTELS &amp; RESORTS
                    </div>
                    <h1 class="mb-2">Phiếu thông tin đặt phòng</h1>
                    <div class="small" style="color: rgba(255, 255, 255, 0.85);">
                        Mã đơn: <strong class="text-white">@Model.MaDon</strong>
                    </div>
                </div>
                <div>
                    <span class="badge @TrangThaiDatPhong.MauBadge(Model.TrangThai)">@TrangThaiDatPhong.HienThi(Model.TrangThai)</span>
                </div>
            </header>

            <div class="booking-detail-body">
                <div class="alert booking-detail-note rounded-4 small mb-4 d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle-fill text-gold mt-1" aria-hidden="true"></i>
                    <div>
                        Đây là phiếu thông tin đặt phòng, <strong>không phải hóa đơn hoặc xác nhận đã thanh toán</strong>. Trạng thái và tổng tiền được cập nhật trực tiếp từ hệ thống khách sạn.
                    </div>
                </div>

                <h2 class="booking-detail-section-title">
                    <i class="bi bi-person-vcard" aria-hidden="true"></i>Thông tin khách đặt
                </h2>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Khách hàng</span>
                            <strong>@Model.TenKhachHang</strong>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Số điện thoại tài khoản</span>
                            <strong>@Model.SoDienThoai</strong>
                        </div>
                    </div>
                </div>

                <h2 class="booking-detail-section-title">
                    <i class="bi bi-calendar-range" aria-hidden="true"></i>Thời gian lưu trú
                </h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Ngày nhận phòng</span>
                            <strong>@(Model.NgayNhan?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Ngày trả phòng</span>
                            <strong>@(Model.NgayTra?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Thời gian tính tiền dự kiến</span>
                            <strong>@(nights.HasValue ? $"{nights} đêm" : "Chưa xác định")</strong>
                        </div>
                    </div>
                </div>

                <h2 class="booking-detail-section-title">
                    <i class="bi bi-door-open" aria-hidden="true"></i>Danh sách phòng
                </h2>
                @if (Model.ChiTietPhong.Count > 0)
                {
                    <div class="table-responsive rounded-4 border mb-4 overflow-hidden">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3 py-3">Phòng</th>
                                    <th scope="col" class="text-end pe-3 py-3">Đơn giá tham khảo / đêm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var phong in Model.ChiTietPhong)
                                {
                                    <tr>
                                        <td class="ps-3 py-3 fw-semibold">
                                            <i class="bi bi-door-open me-2 text-gold" aria-hidden="true"></i>Phòng @phong.SoPhong
                                        </td>
                                        <td class="text-end pe-3 py-3 tabular-nums">@phong.GiaPhong.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-4">Chưa có thông tin phòng trong đơn này.</p>
                }

                <div class="booking-detail-total-bar d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <span class="fw-semibold" style="color: var(--sawade-forest-950);">Tổng tiền đặt phòng theo hệ thống</span>
                    <span class="booking-detail-money">@Model.TongTien.ToString("N0") đ</span>
                </div>

                <p class="text-muted small mb-0">
                    <i class="bi bi-clock me-1" aria-hidden="true"></i>Đặt ngày: @(Model.NgayDat?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật"). Dịch vụ phát sinh và thanh toán thực tế được lễ tân xử lý riêng tại quầy.
                </p>
            </div>
        </article>

        <div class="booking-detail-actions d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="btn btn-sawade-light rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1" aria-hidden="true"></i>Quay lại lịch sử
                </a>
                <a asp-controller="DonDatPhong" asp-action="ChiTiet" asp-route-id="@Model.DatPhongId" class="btn btn-outline-dark rounded-pill px-4">
                    <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Làm mới trạng thái
                </a>
                <button type="button" class="btn btn-sawade-primary rounded-pill px-4" onclick="window.print()">
                    <i class="bi bi-printer me-1" aria-hidden="true"></i>In phiếu
                </button>
            </div>

            @if (canCancel)
            {
                <form asp-controller="TaiKhoan" asp-action="HuyDonHang" method="post" data-sawade-busy="Đang hủy đơn..." onsubmit="return confirm('Bạn có chắc chắn muốn hủy yêu cầu đặt phòng này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datPhongId" value="@Model.DatPhongId" />
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-4">
                        <i class="bi bi-x-circle me-1" aria-hidden="true"></i>Hủy yêu cầu đặt phòng
                    </button>
                </form>
            }
        </div>
    </div>
</div>
