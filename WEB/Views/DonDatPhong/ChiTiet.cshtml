@model QuanLyKhachSan.Web.Models.ChiTietDonViewModel
@{
    ViewData["Title"] = "Chi tiết đơn " + Model.MaDon;
    ViewData["NavbarOverlay"] = false;
    var nights = Model.NgayNhan.HasValue && Model.NgayTra.HasValue
        ? (int?)Math.Max(1, Math.Ceiling((Model.NgayTra.Value - Model.NgayNhan.Value).TotalDays))
        : null;
    var canCancel = TrangThaiDatPhong.ChoPhepHuy(Model.TrangThai);
}

@section Styles {
    <style>
        .booking-detail-page {
            min-height: 74vh;
        }

        .booking-detail-head {
            color: #fff;
        }

        .booking-detail-body {
            overflow-wrap: anywhere;
        }

        .booking-detail-note {
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line-strong) !important;
            border-left: 3px solid var(--sawade-gold-500) !important;
            color: var(--sawade-ink-soft);
        }

        .booking-detail-section-title {
            display: flex;
            align-items: center;
            gap: 10px;
            color: var(--sawade-forest-950);
            margin-bottom: 14px;
            padding-bottom: 8px;
            border-bottom: 1px solid var(--sawade-line);
        }

        .booking-detail-body .table {
            margin-bottom: 0;
            border-color: var(--sawade-line-strong);
        }

        .booking-detail-body .table-light {
            --bs-table-bg: var(--sawade-ivory-100);
            --bs-table-color: var(--sawade-forest-950);
        }

        .booking-detail-total-bar {
            padding: 20px 24px;
            background: var(--sawade-ivory-100);
            border: 1px solid var(--sawade-line-strong);
            border-left: 3px solid var(--sawade-forest-900);
        }

        .booking-detail-actions {
            max-width: 840px;
            margin: 24px auto 0;
        }

        @@media (max-width: 575.98px) {
            .booking-detail-actions > div,
            .booking-detail-actions form {
                width: 100%;
            }
            .booking-detail-actions .btn,
            .booking-detail-actions form .btn {
                width: 100%;
            }
        }

        @@media print {
            @@page {
                size: A4;
                margin: 13mm;
            }
            .navbar,
            .site-footer,
            .booking-detail-actions,
            .booking-detail-note,
            .booking-detail-page .breadcrumb,
            .sawade-back-to-top {
                display: none !important;
            }
            body,
            .booking-detail-page {
                background: #fff !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .booking-detail-sheet {
                max-width: none !important;
                border: 0 !important;
                box-shadow: none !important;
            }
            .booking-detail-head {
                background: #fff !important;
                color: #111C17 !important;
                border-bottom: 2px solid #111C17;
                padding: 10px 0 18px !important;
            }
            .booking-detail-head h1,
            .booking-detail-head strong {
                color: #111C17 !important;
            }
            .booking-detail-body {
                padding: 20px 0 !important;
            }
            .booking-detail-box {
                break-inside: avoid;
            }
            .badge {
                border: 1px solid #666;
                color: #111 !important;
                background: #fff !important;
            }
        }
    </style>
}

<div class="booking-detail-page">
    <div class="container">
        <nav class="breadcrumb small mb-4" aria-label="Đường dẫn">
            <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="text-decoration-none">Tài khoản của tôi</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-muted">Phiếu đặt phòng @Model.MaDon</span>
        </nav>

        <article class="booking-detail-sheet">
            <header class="booking-detail-head d-flex flex-wrap justify-content-between gap-3 align-items-start">
                <div>
                    <div class="luxe-kicker mb-2" style="color: var(--sawade-gold-300);">SAWADE HOTELS &amp; RESORTS &middot; RESERVATION FOLIO</div>
                    <h1 class="mb-2">Phiếu thông tin đặt phòng</h1>
                    <div class="small" style="color: rgba(255, 255, 255, 0.80);">
                        Mã xác nhận: <strong class="text-white" style="letter-spacing: 0.08em;">@Model.MaDon</strong>
                    </div>
                </div>
                <div>
                    <span class="badge @TrangThaiDatPhong.MauBadge(Model.TrangThai)">@TrangThaiDatPhong.HienThi(Model.TrangThai)</span>
                </div>
            </header>

            <div class="booking-detail-body">
                <div class="alert booking-detail-note small mb-4 d-flex align-items-start gap-2">
                    <i class="bi bi-info-circle text-gold mt-1" aria-hidden="true"></i>
                    <div>
                        Đây là phiếu thông tin đặt phòng, <strong>không phải hóa đơn hoặc xác nhận đã thanh toán</strong>. Trạng thái và tổng tiền được cập nhật trực tiếp từ hệ thống khách sạn.
                    </div>
                </div>

                <h2 class="booking-detail-section-title">01 &middot; Thông tin khách đặt</h2>
                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Khách hàng</span>
                            <strong>@Model.TenKhachHang</strong>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Số điện thoại tài khoản</span>
                            <strong class="tabular-nums">@Model.SoDienThoai</strong>
                        </div>
                    </div>
                </div>

                <h2 class="booking-detail-section-title">02 &middot; Thời gian lưu trú</h2>
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Ngày nhận phòng</span>
                            <strong class="tabular-nums">@(Model.NgayNhan?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Ngày trả phòng</span>
                            <strong class="tabular-nums">@(Model.NgayTra?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="booking-detail-box h-100">
                            <span class="booking-detail-label d-block">Thời gian dự kiến</span>
                            <strong>@(nights.HasValue ? $"{nights} đêm" : "Chưa xác định")</strong>
                        </div>
                    </div>
                </div>

                <h2 class="booking-detail-section-title">03 &middot; Danh sách phòng</h2>
                @if (Model.ChiTietPhong.Count > 0)
                {
                    <div class="table-responsive border mb-4">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col" class="ps-3 py-3 small text-uppercase" style="letter-spacing: 0.1em;">Phòng</th>
                                    <th scope="col" class="text-end pe-3 py-3 small text-uppercase" style="letter-spacing: 0.1em;">Đơn giá / đêm</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var phong in Model.ChiTietPhong)
                                {
                                    <tr>
                                        <td class="ps-3 py-3 fw-semibold">Phòng @phong.SoPhong</td>
                                        <td class="text-end pe-3 py-3 tabular-nums">@phong.GiaPhong.ToString("N0") đ</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted mb-4">Chưa có thông tin phòng trong đơn này.</p>
                }

                <div class="booking-detail-total-bar d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <span class="small fw-semibold text-uppercase" style="letter-spacing: 0.12em; color: var(--sawade-forest-950);">Tổng tiền đặt phòng theo hệ thống</span>
                    <span class="booking-detail-money">@Model.TongTien.ToString("N0") đ</span>
                </div>

                <p class="text-muted small mb-0">
                    Đặt ngày: @(Model.NgayDat?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa cập nhật"). Dịch vụ phát sinh và thanh toán thực tế được lễ tân xử lý riêng tại quầy.
                </p>
            </div>
        </article>

        <div class="booking-detail-actions d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="TaiKhoan" asp-action="HoSoCaNhan" class="btn btn-sawade-light">
                    <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Quay lại lịch sử
                </a>
                <a asp-controller="DonDatPhong" asp-action="ChiTiet" asp-route-id="@Model.DatPhongId" class="btn btn-outline-dark">
                    <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>Làm mới
                </a>
                <button type="button" class="btn btn-sawade-primary" onclick="window.print()">
                    <i class="bi bi-printer me-2" aria-hidden="true"></i>In phiếu A4
                </button>
            </div>

            @if (canCancel)
            {
                <form asp-controller="TaiKhoan" asp-action="HuyDonHang" method="post" data-sawade-busy="Đang hủy đơn..." onsubmit="return confirm('Bạn có chắc chắn muốn hủy yêu cầu đặt phòng này?');">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="datPhongId" value="@Model.DatPhongId" />
                    <button type="submit" class="btn btn-outline-danger">
                        Hủy yêu cầu đặt phòng
                    </button>
                </form>
            }
        </div>
    </div>
</div>
