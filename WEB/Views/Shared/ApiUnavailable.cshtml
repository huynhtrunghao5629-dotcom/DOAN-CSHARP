@{
    ViewData["NavbarOverlay"] = false;
}
<section class="luxe-page">
    <div class="container" style="max-width: 640px;">
        <div class="confirm-card text-center" role="alert">
            <div class="sawade-empty-icon mb-4"><i class="bi bi-wifi-off" aria-hidden="true"></i></div>
            <div class="luxe-kicker mb-2">CONNECTION NOTICE</div>
            <h1 class="luxe-title h2 mb-3">Chưa thể tải thông tin phòng</h1>
            <p class="luxe-lead mb-4">@(ViewBag.ThongBaoLoiKetNoi ?? "Không thể kết nối đến hệ thống máy chủ. Vui lòng thử lại sau ít phút.")</p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a href="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" class="btn btn-sawade-primary">
                    <i class="bi bi-arrow-clockwise me-2" aria-hidden="true"></i>Thử tải lại
                </a>
                <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-sawade-light">Danh sách phòng</a>
            </div>
        </div>
    </div>
</section>
