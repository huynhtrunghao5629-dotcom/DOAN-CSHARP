@{
    ViewData["NavbarOverlay"] = false;
}
<section class="container py-5 my-5" style="max-width:680px">
    <div class="bg-white rounded-4 p-4 p-md-5 text-center shadow-sm" role="alert">
        <div class="sawade-empty-icon mb-3"><i class="bi bi-wifi-off" aria-hidden="true"></i></div>
        <h1 class="h3 fw-bold mb-3" style="color:#24392f">Chưa thể tải thông tin phòng</h1>
        <p class="text-muted mb-4">@(ViewBag.ThongBaoLoiKetNoi ?? "Không thể kết nối hệ thống. Vui lòng thử lại sau.")</p>
        <div class="d-flex justify-content-center flex-wrap gap-2">
            <a href="@(Context.Request.Path.ToString() + Context.Request.QueryString.ToString())" class="btn btn-sawade rounded-pill px-4"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Thử tải lại</a>
            <a asp-controller="Home" asp-action="DanhSachPhong" class="btn btn-outline-dark rounded-pill px-4">Xem danh sách phòng</a>
        </div>
    </div>
</section>
