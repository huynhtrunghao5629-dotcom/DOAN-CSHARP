@{
    var navbarOverlay = ViewData["NavbarOverlay"] is bool value && value;
    var flashSuccess = TempData["ThongBao"] as string;
    var flashError = TempData["Loi"] as string;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khách sạn SAWADE</title>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    @if (navbarOverlay)
    {
        <link rel="preload" as="image" href="https://images.unsplash.com/photo-1542314831-c6a4d27ce66f?q=80&amp;w=2000&amp;auto=format&amp;fit=crop" fetchpriority="high" />
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sawade-luxe.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <link rel="stylesheet" href="~/css/sawade-final.css" asp-append-version="true" />
</head>
<body>
    <div id="sawadeNavigationProgress" class="sawade-navigation-progress" aria-hidden="true"></div>
    <div id="sawadeOfflineBanner" class="sawade-offline-banner" role="status" hidden>
        <i class="bi bi-wifi-off me-2" aria-hidden="true"></i>Mất kết nối Internet. Vui lòng kiểm tra mạng trước khi tiếp tục.
    </div>

    @if (!string.IsNullOrWhiteSpace(flashSuccess) || !string.IsNullOrWhiteSpace(flashError))
    {
        <div class="sawade-flash-stack" aria-label="Thông báo của hệ thống">
            @if (!string.IsNullOrWhiteSpace(flashError))
            {
                <div class="alert alert-danger alert-dismissible shadow-sm rounded-4 sawade-flash" role="alert">
                    <i class="bi bi-exclamation-circle-fill me-2" aria-hidden="true"></i>@flashError
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo lỗi"></button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(flashSuccess))
            {
                <div class="alert alert-success alert-dismissible shadow-sm rounded-4 sawade-flash" role="status" data-sawade-auto-dismiss="true">
                    <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@flashSuccess
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo thành công"></button>
                </div>
            }
        </div>
    }

    <nav class="navbar navbar-expand-lg navbar-sawade @(navbarOverlay ? "navbar-overlay" : string.Empty)">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index" aria-label="Sawade Hotels & Resorts - Trang chủ">
                <span class="brand-emblem"><i class="bi bi-stars" aria-hidden="true"></i></span>
                <span class="d-block">
                    <span class="brand-name d-block">Sawade</span>
                    <span class="brand-subtitle d-block">Hotels · Resorts</span>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Mở menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(currentController == "Home" && currentAction == "Index" ? "active" : "")" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(currentController == "Home" && (currentAction == "DanhSachPhong" || currentAction == "ChiTietPhong") ? "active" : "")" asp-controller="Home" asp-action="DanhSachPhong">Phòng nghỉ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" href="@(Url.Action("Index", "Home"))#loai-phong">Hạng phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(currentController == "Home" && currentAction == "DichVu" ? "active" : "")" asp-controller="Home" asp-action="DichVu">Dịch vụ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase @(currentController == "Home" && currentAction == "HuongDan" ? "active" : "")" asp-controller="Home" asp-action="HuongDan">Hướng dẫn</a>
                    </li>
                </ul>

                <div class="sawade-nav-actions d-flex align-items-center gap-2 ms-auto">
                    <button type="button" class="btn btn-sawade-light rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#searchRoomModal">
                        <i class="bi bi-search me-1" aria-hidden="true"></i>Tìm phòng
                    </button>

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="btn btn-sawade-primary rounded-pill px-3 dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2" aria-hidden="true"></i>@User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-4 p-2" aria-labelledby="userMenu">
                                <li><a class="dropdown-item rounded-3 py-2 fw-semibold" asp-controller="TraCuuDon" asp-action="Index"><i class="bi bi-clock-history me-2 text-muted"></i>Lịch sử đặt phòng</a></li>
                                <li><a class="dropdown-item rounded-3 py-2 fw-semibold" asp-controller="TaiKhoan" asp-action="HoSoCaNhan"><i class="bi bi-person-lines-fill me-2 text-muted"></i>Hồ sơ cá nhân</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post">
                                        <button type="submit" class="dropdown-item rounded-3 py-2 fw-bold text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn btn-sawade-primary rounded-pill px-3 dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-circle me-2" aria-hidden="true"></i>Tài khoản
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2 rounded-4 p-2" aria-labelledby="userMenu">
                                <li><a class="dropdown-item rounded-3 py-2 fw-semibold" asp-controller="TaiKhoan" asp-action="DangNhap"><i class="bi bi-box-arrow-in-right me-2 text-muted"></i>Đăng nhập</a></li>
                                <li><a class="dropdown-item rounded-3 py-2 fw-semibold" asp-controller="TaiKhoan" asp-action="DangKy"><i class="bi bi-person-plus me-2 text-muted"></i>Đăng ký</a></li>
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="page-transition">
        @RenderBody()
    </main>

    <footer class="site-footer text-white">
        <div class="footer-main">
            <div class="container">
                <div class="row g-4 g-lg-5">
                    <div class="col-lg-5">
                        <div class="footer-mark mb-3"><i class="bi bi-stars me-2" aria-hidden="true"></i>SAWADE</div>
                        <p class="footer-brand-copy mb-0">Không gian nghỉ dưỡng được chăm chút từ những chi tiết nhỏ, để mỗi kỳ lưu trú trở thành một trải nghiệm nhẹ nhàng và đáng nhớ.</p>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="footer-heading">Khám phá</div>
                        <a class="footer-link" asp-controller="Home" asp-action="DanhSachPhong">Phòng nghỉ</a>
                        <a class="footer-link" asp-controller="Home" asp-action="DichVu">Dịch vụ</a>
                        <a class="footer-link" href="@(Url.Action("Index", "Home"))#loai-phong">Hạng phòng</a>
                    </div>
                    <div class="col-6 col-lg-2">
                        <div class="footer-heading">Hỗ trợ</div>
                        <a class="footer-link" asp-controller="Home" asp-action="HuongDan">Hướng dẫn đặt phòng</a>
                        <a class="footer-link" asp-controller="Home" asp-action="Privacy">Quyền riêng tư</a>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="footer-link" asp-controller="TraCuuDon" asp-action="Index">Lịch sử đặt phòng</a>
                        }
                    </div>
                    <div class="col-lg-3">
                        <div class="footer-heading">Đặt kỳ nghỉ</div>
                        <p class="small text-white-50 mb-3">Chọn ngày lưu trú và kiểm tra phòng trống trực tiếp trên hệ thống.</p>
                        <button type="button" class="btn btn-outline-light rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#searchRoomModal"><i class="bi bi-calendar2-heart me-2"></i>Tìm phòng ngay</button>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container d-flex flex-wrap justify-content-between gap-2">
                <span>&copy; @DateTime.Now.Year SAWADE Hotels &amp; Resorts.</span>
                <span>Đặt phòng trực tuyến · Dữ liệu đồng bộ từ hệ thống khách sạn</span>
            </div>
        </div>
    </footer>

    <div class="modal fade" id="searchRoomModal" tabindex="-1" aria-labelledby="searchRoomTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header px-4 pt-4">
                    <div>
                        <div class="luxe-kicker mb-1">SAWADE RESERVATION</div>
                        <h2 class="modal-title h4 fw-bold mb-0" id="searchRoomTitle">Tìm kỳ nghỉ phù hợp</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form asp-controller="Home" asp-action="DanhSachPhong" method="get" class="modal-body p-4" id="quickRoomSearch" data-sawade-busy="Đang tìm phòng...">
                    <label class="form-label fw-semibold" for="searchCheckIn">Ngày nhận phòng</label>
                    <input class="form-control mb-3" type="date" id="searchCheckIn" name="ngayNhan" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    <label class="form-label fw-semibold" for="searchCheckOut">Ngày trả phòng</label>
                    <input class="form-control mb-3" type="date" id="searchCheckOut" name="ngayTra" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
                    <label class="form-label fw-semibold" for="searchGuests">Số khách lưu trú</label>
                    <select class="form-select mb-3" id="searchGuests" name="soKhach">
                        <option value="">Tất cả</option>
                        @for (int guestCount = 1; guestCount <= 10; guestCount++)
                        {
                            <option value="@guestCount">@guestCount người</option>
                        }
                    </select>
                    <p id="searchRoomError" class="text-danger small" role="alert" hidden>Ngày trả phòng phải sau ngày nhận phòng.</p>
                    <button type="submit" class="btn btn-sawade-primary w-100 rounded-pill py-3">Kiểm tra phòng trống <i class="bi bi-arrow-right ms-1"></i></button>
                </form>
            </div>
        </div>
    </div>

    @RenderSection("Modals", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
    <script>
      (() => {
        const start = document.getElementById('searchCheckIn'), end = document.getElementById('searchCheckOut');
        const form = document.getElementById('quickRoomSearch'), error = document.getElementById('searchRoomError');
        if (!start || !end || !form) return;
        const validate = () => {
          if (start.value) {
            const d = new Date(start.value + 'T00:00:00');
            d.setDate(d.getDate() + 1);
            const min = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
            end.min = min;
          }
          const valid = !!start.value && !!end.value && end.value > start.value;
          error.hidden = valid || !end.value;
          return valid;
        };
        start.addEventListener('change', validate);
        end.addEventListener('change', validate);
        form.addEventListener('submit', e => { if (!validate()) { e.preventDefault(); end.focus(); } });
      })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
