@{
    var navbarOverlay = ViewData["NavbarOverlay"] is bool value && value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sawade Hotels &amp; Resorts</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <style>
        .page-transition {
            animation: fadeAndSlideIn 0.4s ease-out forwards;
        }

        @@keyframes fadeAndSlideIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }</style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-sawade py-3 @(navbarOverlay ? "navbar-overlay" : string.Empty)">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index" aria-label="Sawade Hotels & Resorts - Trang chủ">
                <i class="bi bi-buildings me-2 fs-2" aria-hidden="true"></i>
                <span class="d-block">
                    <span class="brand-name d-block">Sawade</span>
                    <span class="brand-subtitle d-block">Hotels &amp; Resorts</span>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Mở menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" asp-controller="Home" asp-action="DanhSachPhong">Danh sách phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" href="@(Url.Action("Index", "Home"))#loai-phong">Hạng phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" href="@(Url.Action("Index", "Home"))#phong-noi-bat">Phòng nổi bật</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    <a href="/Home/DanhSachPhong" class="btn btn-light rounded-pill px-3 border" style="background: rgba(255,255,255,0.8);">
                        <i class="bi bi-search me-1"></i> Tìm phòng
                    </a>

                    <!-- KIỂM TRA ĐĂNG NHẬP -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="btn btn-dark rounded-pill px-3 dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #24392f; border-color: #24392f;">
                                <i class="bi bi-person-circle me-2"></i> Chào, @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenu" style="border-radius: 12px;">
                                <!-- Trỏ về trang Tra cứu nếu họ muốn tra bằng SĐT khác -->
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TraCuuDon/Index"><i class="bi bi-search me-2 text-muted"></i>Tra cứu đơn (SĐT)</a></li>

                                <!-- GẮN LINK HỒ SƠ CÁ NHÂN VÀO ĐÂY -->
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/HoSoCaNhan"><i class="bi bi-person-lines-fill me-2 text-muted"></i>Hồ sơ cá nhân</a></li>

                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 fw-bold text-danger" href="/TaiKhoan/DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn btn-dark rounded-pill px-3 dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #24392f; border-color: #24392f;">
                                <i class="bi bi-person-circle me-2"></i> Tài khoản
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenu" style="border-radius: 12px;">
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/DangNhap"><i class="bi bi-box-arrow-in-right me-2 text-muted"></i>Đăng nhập</a></li>
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/DangKy"><i class="bi bi-person-plus me-2 text-muted"></i>Đăng ký</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TraCuuDon/Index"><i class="bi bi-search me-2 text-muted"></i>Tra cứu đặt phòng</a></li>
                            </ul>
                        </div>
                    }
                </div>
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-3 page-transition">
        @RenderBody()
    </main>

    <footer class="site-footer text-white text-center py-5 mt-5">
        <div class="container">
            <div class="footer-mark mb-2"><i class="bi bi-buildings me-2" aria-hidden="true"></i>SAWADE</div>
            <p class="text-white-50 mb-3">Hotels &amp; Resorts · Nơi kỳ nghỉ trở thành kỷ niệm</p>
            <div class="footer-line mx-auto mb-3"></div>
            <small class="text-white-50">&copy; @DateTime.Now.Year Sawade Hotels &amp; Resorts. Bảo lưu mọi quyền.</small>
        </div>
    </footer>
    @RenderSection("Modals", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
