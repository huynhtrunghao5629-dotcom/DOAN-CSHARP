@{
    var navbarOverlay = ViewData["NavbarOverlay"] is bool value && value;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Khách sạn SAWADE</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
    <style>
        .page-transition {
            animation: fadeAndSlideIn 0.4s ease-out forwards;
        }

        @@keyframes fadeAndSlideIn {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }</style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-sawade py-3 @(navbarOverlay ? "navbar-overlay" : string.Empty)">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index" aria-label="Sawade Hotels & Resorts - Trang chủ">
                <i class="bi bi-buildings me-2 fs-2" aria-hidden="true"></i>
                <span class="d-block">
                    <span class="brand-name d-block">Sawade</span>
                    <span class="brand-subtitle d-block">Khách sạn &amp; Khu nghỉ dưỡng</span>
                </span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Mở menu điều hướng">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-3">
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" asp-controller="Home" asp-action="Index">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" asp-controller="Home" asp-action="DanhSachPhong">Danh sách phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" href="@(Url.Action("Index", "Home"))#loai-phong">Hạng phòng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-uppercase" href="@(Url.Action("Index", "Home"))#phong-noi-bat">Phòng nổi bật</a>
                    </li>
                    <li class="nav-item"><a class="nav-link text-uppercase" asp-controller="Home" asp-action="DichVu">Dịch vụ</a></li>
                    <li class="nav-item"><a class="nav-link text-uppercase" asp-controller="Home" asp-action="HuongDan">Hướng dẫn</a></li>
                </ul>

                <div class="d-flex align-items-center gap-3 ms-auto">
                    <button type="button" class="btn btn-light rounded-pill px-3 border" style="background: rgba(255,255,255,0.8);" data-bs-toggle="modal" data-bs-target="#searchRoomModal"><i class="bi bi-search me-1"></i> Tìm phòng</button>

                    <!-- KIỂM TRA ĐĂNG NHẬP -->
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        <div class="dropdown">
                            <button class="btn btn-dark rounded-pill px-3 dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #24392f; border-color: #24392f;">
                                <i class="bi bi-person-circle me-2"></i> Chào, @User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenu" style="border-radius: 12px;">
                                <!-- Chỉ tra cứu đơn của tài khoản đang đăng nhập. -->
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TraCuuDon/Index"><i class="bi bi-search me-2 text-muted"></i>Lịch sử đơn đặt</a></li>

                                <!-- GẮN LINK HỒ SƠ CÁ NHÂN VÀO ĐÂY -->
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/HoSoCaNhan"><i class="bi bi-person-lines-fill me-2 text-muted"></i>Hồ sơ cá nhân</a></li>

                                <li><hr class="dropdown-divider"></li>
                                <li><form asp-controller="TaiKhoan" asp-action="DangXuat" method="post"><button type="submit" class="dropdown-item py-2 fw-bold text-danger"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button></form></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="dropdown">
                            <button class="btn btn-dark rounded-pill px-3 dropdown-toggle d-flex align-items-center" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="background-color: #24392f; border-color: #24392f;">
                                <i class="bi bi-person-circle me-2"></i> Tài khoản
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="userMenu" style="border-radius: 12px;">
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/DangNhap"><i class="bi bi-box-arrow-in-right me-2 text-muted"></i>Đăng nhập</a></li>
                                <li><a class="dropdown-item py-2 fw-semibold" href="/TaiKhoan/DangKy"><i class="bi bi-person-plus me-2 text-muted"></i>Đăng ký</a></li>
                                
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main role="main" class="pb-3 page-transition">
        @RenderBody()
    </main>

    <footer class="site-footer text-white text-center py-5 mt-5">
        <div class="container">
            <div class="footer-mark mb-2"><i class="bi bi-buildings me-2" aria-hidden="true"></i>SAWADE</div>
            <p class="text-white-50 mb-3">Khách sạn &amp; Khu nghỉ dưỡng · Nơi kỳ nghỉ trở thành kỷ niệm</p>
            <p class="small mb-3"><a class="link-light text-decoration-none" asp-controller="Home" asp-action="HuongDan">Hướng dẫn đặt phòng</a><span class="mx-2 text-white-50">·</span><a class="link-light text-decoration-none" asp-controller="Home" asp-action="Privacy">Thông tin quyền riêng tư</a></p>
            <div class="footer-line mx-auto mb-3"></div>
            <small class="text-white-50">&copy; @DateTime.Now.Year Khách sạn SAWADE. Bảo lưu mọi quyền.</small>
        </div>
    </footer>

    <div class="modal fade" id="searchRoomModal" tabindex="-1" aria-labelledby="searchRoomTitle" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered"><div class="modal-content rounded-4 border-0 shadow">
        <div class="modal-header"><h2 class="modal-title h5 fw-bold" id="searchRoomTitle">Tìm phòng phù hợp</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <form asp-controller="Home" asp-action="DanhSachPhong" method="get" class="modal-body p-4" id="quickRoomSearch">
          <label class="form-label fw-semibold" for="searchCheckIn">Ngày nhận phòng</label><input class="form-control mb-3" type="date" id="searchCheckIn" name="ngayNhan" min="@DateTime.Today.ToString("yyyy-MM-dd")" required />
          <label class="form-label fw-semibold" for="searchCheckOut">Ngày trả phòng</label><input class="form-control mb-3" type="date" id="searchCheckOut" name="ngayTra" min="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")" required />
          <label class="form-label fw-semibold" for="searchGuests">Số khách lưu trú</label>
          <select class="form-select mb-3" id="searchGuests" name="soKhach">
            <option value="">Tất cả</option>
            @for (int guestCount = 1; guestCount <= 10; guestCount++) { <option value="@guestCount">@guestCount người</option> }
          </select>
          <p id="searchRoomError" class="text-danger small" role="alert" hidden>Ngày trả phòng phải sau ngày nhận phòng.</p>
          <button type="submit" class="btn w-100 rounded-pill text-white py-2" style="background:#24392f">Kiểm tra phòng trống</button>
        </form>
      </div></div>
    </div>
    @RenderSection("Modals", required: false)
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
      (() => {
        const start = document.getElementById('searchCheckIn'), end = document.getElementById('searchCheckOut');
        const form = document.getElementById('quickRoomSearch'), error = document.getElementById('searchRoomError');
        if (!start || !end || !form) return;
        const validate = () => {
          if (start.value) { const d = new Date(start.value+'T00:00:00'); d.setDate(d.getDate()+1);
            const min = d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
            end.min = min; }
          const valid = !!start.value && !!end.value && end.value > start.value;
          error.hidden = valid || !end.value; return valid;
        };
        start.addEventListener('change', validate); end.addEventListener('change',validate);
        form.addEventListener('submit',e=>{if (!validate()){e.preventDefault();end.focus();}});
      })();
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
