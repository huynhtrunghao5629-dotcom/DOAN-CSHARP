@model ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi";
    ViewData["NavbarOverlay"] = false;
}
<section class="luxe-page">
    <div class="container" style="max-width: 640px;">
        <div class="confirm-card text-center">
            <div class="sawade-empty-icon mb-4"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>
            <div class="luxe-kicker mb-2">SYSTEM NOTICE</div>
            <h1 class="luxe-title h2 mb-3">Rất tiếc, trang đã xảy ra lỗi</h1>
            <p class="luxe-lead mb-4">Hệ thống chưa thể xử lý yêu cầu lúc này. Bạn có thể quay về trang chủ và thử lại.</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-sawade-primary">Về trang chủ</a>
            @if (Model?.ShowRequestId == true)
            {
                <p class="small text-muted mt-4 mb-0">Mã tham chiếu: <code>@Model.RequestId</code></p>
            }
        </div>
    </div>
</section>
