@model IEnumerable<QuanLyKhachSan.Web.Models.PhongViewModel>

<div class="container mt-5">
    <h3 class="fw-bold mb-3">Danh sách phòng hiện có</h3>
    <div class="row">
        @foreach (var phong in Model)
        {
            <div class="col-md-4">
                <div class="card shadow-sm mb-4">
                    <img src="https://via.placeholder.com/300x200" class="card-img-top" alt="Ảnh phòng">
                    <div class="card-body">
                        <h5>Phòng @phong.SoPhong</h5>
                        <p class="text-muted small">Loại phòng: @phong.TenLoaiPhong</p>
                        <h6 class="text-primary fw-bold">
                            @phong.GiaPhong.ToString("#,##0")đ <small class="text-muted fw-normal">/ đêm</small>
                        </h6>
                        <p>Trạng thái: @phong.TrangThai</p>
                        <a href="/Home/Detail/@phong.PhongId" class="btn btn-primary btn-sm w-100">Xem chi tiết</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>