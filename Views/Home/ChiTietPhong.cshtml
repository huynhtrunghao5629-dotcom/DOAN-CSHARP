@model QuanLyKhachSan.Web.Models.PhongViewModel
@{
    ViewData["Title"] = "Chi tiết phòng " + Model.SoPhong;
}

<div class="container mt-5 mb-5">
    <div class="row bg-white p-4 shadow-sm rounded">
        <div class="col-md-6">
            <img src="https://via.placeholder.com/600x400" class="img-fluid rounded mb-2">
        </div>
        <div class="col-md-6">
            <h2 class="fw-bold">Phòng @Model.SoPhong - @Model.TenLoaiPhong</h2>
            <h3 class="text-primary fw-bold">@Model.GiaPhong.ToString("#,##0")đ <span class="fs-6 text-muted">/ đêm</span></h3>
            <p>Trạng thái: <strong>@Model.TrangThai</strong></p>
            <p>Phòng đầy đủ tiện nghi, view biển, phù hợp cho 2 người.</p>

            <hr />
            <h5 class="fw-bold">Thông tin đặt phòng</h5>
            <form class="row g-3 mt-2">
                <!-- Chứa ẩn ID phòng để submit -->
                <input type="hidden" name="PhongId" value="@Model.PhongId" />

                <div class="col-md-12">
                    <input type="text" class="form-control" name="HoTen" placeholder="Họ và tên khách hàng">
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control" name="SoDienThoai" placeholder="Số điện thoại">
                </div>
                <div class="col-md-6">
                    <input type="text" class="form-control" name="CCCD" placeholder="CCCD/CMND">
                </div>
                <div class="col-md-6">
                    <label class="form-label small">Ngày nhận</label>
                    <input type="date" class="form-control" name="NgayNhan">
                </div>
                <div class="col-md-6">
                    <label class="form-label small">Ngày trả</label>
                    <input type="date" class="form-control" name="NgayTra">
                </div>
                <div class="col-md-12 mt-4">
                    <button type="submit" class="btn btn-success btn-lg w-100">Xác nhận đặt phòng</button>
                </div>
            </form>
        </div>
    </div>
</div>