@model IEnumerable<QuanLyKhachSan.Web.Models.PhongViewModel>
@{
    ViewData["Title"] = "Danh sách phòng";
}

<div class="container mt-5 mb-5">
    <div class="row">
        <!-- Bộ lọc -->
        <div class="col-md-3">
            <div class="card p-3 shadow-sm">
                <h5 class="fw-bold">Bộ lọc</h5>
                <hr>
                <div class="mb-3">
                    <label class="fw-bold mb-2">Mức giá</label>
                    <input type="range" class="form-range" min="500000" max="5000000">
                </div>
                <button class="btn btn-primary w-100">Áp dụng</button>
            </div>
        </div>

        <!-- Danh sách phòng -->
        <div class="col-md-9">
            <h4 class="fw-bold mb-3">Danh sách phòng hiện có</h4>
            <div class="row g-3">
                @foreach (var p in Model)
                {
                    <div class="col-md-4">
                        <div class="card shadow-sm h-100">
                            <img src="https://via.placeholder.com/300x200" class="card-img-top">
                            <div class="card-body">
                                <h6>Phòng @p.SoPhong (@p.TenLoaiPhong)</h6>
                                <p class="text-primary fw-bold mb-2">@p.GiaPhong.ToString("#,##0")đ <small class="text-muted">/ đêm</small></p>
                                <p class="small text-muted mb-3">
                                    Trạng thái:
                                    <span class="@(p.TrangThai == "Trống" ? "text-success" : "text-danger")">@p.TrangThai</span>
                                </p>
                                <!-- Nút này sẽ truyền PhongId sang trang Chi Tiết -->
                                <a href="/Home/ChiTietPhong/@p.PhongId" class="btn btn-primary btn-sm w-100">Xem chi tiết</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>